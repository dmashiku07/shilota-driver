        <item name="android:editTextStyle">@style/ShilotaEditText</item>
        <item name="editTextStyle">@style/ShilotaEditText</item>
        <item name="android:buttonStyle">@style/ShilotaButton</item>
        <item name="buttonStyle">@style/ShilotaButton</item>
        <item name="materialButtonStyle">@style/ShilotaMaterialButton</item>
        <item name="android:textViewStyle">@style/ShilotaTextView</item>
    </style>

    <style name="SplashTheme" parent="@style/Theme.AppCompat.Light.NoActionBar">
        <!-- Customize your theme here. -->
        <item name="windowNoTitle">true</item>
        <item name="windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowTranslucentStatus">false</item>
        <item name="android:fontFamily">@font/font_regular</item>
        <item name="fontFamily">@font/font_regular</item>
        <item name="android:windowBackground">@color/colorSecondary</item>
        <item name="android:textColorPrimary">@color/textPrimary</item>
        <item name="android:textColorSecondary">@color/textsecondary</item>
        <item name="android:textColorHint">@color/texttertiary</item>
        <item name="android:editTextStyle">@style/ShilotaEditText</item>
        <item name="editTextStyle">@style/ShilotaEditText</item>
        <item name="android:buttonStyle">@style/ShilotaButton</item>
        <item name="buttonStyle">@style/ShilotaButton</item>
        <item name="materialButtonStyle">@style/ShilotaMaterialButton</item>
        <item name="android:textViewStyle">@style/ShilotaTextView</item>

        <!--Required Api 21 above-->
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:statusBarColor">@color/colorPrimaryDark</item>
    </style>

