<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/activity_main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/driver_canvas">
    <LinearLayout
        android:id="@+id/switchLay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="12dp"
        android:gravity="end|center_vertical"
        android:orientation="horizontal"
        android:padding="8dp"
        android:layout_alignParentTop="true"
        android:layout_marginStart="16dp">
        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/onlineSwitch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:theme="@style/Color1SwitchStyle"
            android:minHeight="48dp"
            android:textSize="@dimen/driver_type_body"
            android:fontFamily="@font/font_regular" />
        <TextView
            android:id="@+id/online_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/font_regular"
            android:text="@string/online"
            android:textColor="@color/driver_muted"
            android:textSize="@dimen/driver_type_body"
            android:layout_marginStart="8dp" />
    </LinearLayout>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/acceptRide"
        android:id="@+id/timerLay"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:paddingTop="8dp"
        android:layout_below="@id/switchLay"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="start"
            android:orientation="vertical"
            android:paddingBottom="12dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"
                android:background="@drawable/driver_card">
                <TextView
                    android:id="@+id/txtPickupLocation"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="0dp"
                    android:layout_marginEnd="0dp"
                    android:layout_marginStart="0dp"
                    android:fontFamily="@font/font_regular"
                    android:gravity="start"
                    android:text="@string/ride_pickup_value"
                    android:textColor="@color/textPrimary"
                    android:textSize="@dimen/driver_type_body"
                    android:paddingTop="8dp"
                    android:paddingBottom="12dp" />
                <TextView
                    android:id="@+id/txtDropLocation"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="0dp"
                    android:layout_marginTop="0dp"
                    android:layout_marginEnd="0dp"
                    android:fontFamily="@font/font_regular"
                    android:gravity="start"
                    android:text="@string/ride_destination_value"
                    android:textColor="@color/textPrimary"
                    android:textSize="@dimen/driver_type_body"
                    android:paddingTop="8dp"
                    android:paddingBottom="12dp" />
            </LinearLayout>
            <TextView
                android:id="@+id/requestPickupEstimate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:padding="12dp"
                android:background="@drawable/driver_soft_card"
                android:fontFamily="@font/font_regular"
                android:textSize="@dimen/driver_type_body"
                android:textColor="@color/textPrimary"
                android:text="@string/request_pickup_unavailable" />
            <TextView
                android:id="@+id/requestTripEstimate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:padding="12dp"
                android:background="@drawable/driver_soft_card"
                android:fontFamily="@font/font_regular"
                android:textSize="@dimen/driver_type_body"
                android:textColor="@color/textPrimary"
                android:text="@string/request_trip_unavailable" />
            <TextView
                android:id="@+id/textViewTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="start"
                android:layout_marginStart="0dp"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="5dp"
                android:fontFamily="@font/font_regular"
                android:gravity="center"
                android:textColor="@color/colorPrimary"
                android:textSize="@dimen/driver_type_heading"
                android:textStyle="bold" />
            <ProgressBar
                android:id="@+id/progressBarCircle"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:background="@color/driver_line"
                android:indeterminate="false"
                android:max="60"
                android:progress="60"
                android:progressDrawable="@drawable/driver_request_progress"
                android:rotation="0"
                android:layout_marginTop="8dp" />
            <EditText
                android:id="@+id/offerPriceInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="0dp"
                android:layout_marginTop="18dp"
                android:layout_marginEnd="0dp"
                android:background="@drawable/driver_field"
                android:ems="10"
                android:fontFamily="@font/font_regular"
                android:hint="@string/offer_price_hint"
                android:inputType="numberDecimal"
                android:padding="16dp"
                android:textColor="@color/textPrimary"
                android:textColorHint="@color/driver_muted"
                android:textSize="@dimen/driver_type_body"
                android:minHeight="48dp"
                android:backgroundTint="@null"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                app:backgroundTint="@null"
                android:paddingTop="10dp"
                android:paddingBottom="10dp" />
        </LinearLayout>
    </ScrollView>
    <TextView
        android:id="@+id/acceptRide"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:layout_alignParentBottom="true"
        android:background="@drawable/primary_bg"
        android:fontFamily="@font/font_regular"
        android:gravity="center"
        android:paddingBottom="10dp"
        android:paddingTop="10dp"
        android:text="@string/submit_offer"
        android:textColor="@color/colorSecondary"
        android:textSize="@dimen/driver_type_body"
        android:minHeight="48dp"
        android:textStyle="bold"
        android:padding="16dp" />
</RelativeLayout>
