<?xml version="1.0" encoding="utf-8"?>
<layout
    xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp"
        android:background="@drawable/driver_card"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="4dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp">
        <TextView
            android:id="@+id/riderName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/font_regular"
            android:textColor="@color/textPrimary"
            android:textSize="@dimen/driver_type_body" />
        <TextView
            android:id="@+id/itemDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="@font/font_regular"
            android:textColor="@color/textPrimary"
            android:textSize="@dimen/driver_type_body" />
        <TextView
            android:id="@+id/tripDetail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="@font/font_regular"
            android:textColor="@color/textsecondary"
            android:textSize="@dimen/driver_type_caption" />
        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="@font/font_regular"
            android:textColor="@color/green"
            android:textSize="@dimen/driver_type_body" />
        <TextView
            android:id="@+id/latestMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="@font/font_regular"
            android:textColor="@color/textsecondary"
            android:textSize="@dimen/driver_type_caption" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/callRider"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/rect_border_primary"
                android:fontFamily="@font/font_regular"
                android:gravity="center"
                android:text="@string/call_rider"
                android:textColor="@color/colorPrimary"
                android:textSize="@dimen/driver_type_body" />
            <TextView
                android:id="@+id/openChat"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/rect_border_primary"
                android:fontFamily="@font/font_regular"
                android:gravity="center"
                android:text="@string/open_chat"
                android:textColor="@color/colorPrimary"
                android:textSize="@dimen/driver_type_body" />
            <TextView
                android:id="@+id/markFound"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/rect_border_primary"
                android:fontFamily="@font/font_regular"
                android:gravity="center"
                android:text="@string/mark_found"
                android:textColor="@color/colorPrimary"
                android:textSize="@dimen/driver_type_body" />
            <TextView
                android:id="@+id/markReturned"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:background="@drawable/rect_border_primary"
                android:fontFamily="@font/font_regular"
                android:gravity="center"
                android:text="@string/mark_returned"
                android:textColor="@color/colorPrimary"
                android:textSize="@dimen/driver_type_body" />
        </LinearLayout>
    </LinearLayout>
</layout>
