<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/driver_canvas"
    android:clipToPadding="false">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/destination_broadcast_title"
            android:textColor="@color/colorSecondary"
            android:textSize="@dimen/driver_type_heading"
            android:fontFamily="@font/font_regular" />
        <TextView
            android:id="@+id/broadcastFeeSummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/outline_bg"
            android:padding="12dp"
            android:text="@string/destination_broadcast_fee_loading"
            android:textColor="@color/colorSecondary"
            android:fontFamily="@font/font_regular"
            android:textSize="@dimen/driver_type_body" />
        <EditText
            android:id="@+id/originLabelInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/driver_field"
            android:hint="@string/origin_label_hint"
            android:padding="12dp"
            android:backgroundTint="@null"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:textSize="@dimen/driver_type_body"
            android:textColor="@color/textPrimary"
            android:textColorHint="@color/driver_muted"
            app:backgroundTint="@null"
            android:minHeight="48dp"
            android:fontFamily="@font/font_regular" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <EditText
                android:id="@+id/originLatInput"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginTop="8dp"
                android:background="@drawable/driver_field"
                android:hint="@string/lat_hint"
                android:inputType="numberDecimal|numberSigned"
                android:padding="12dp"
                android:backgroundTint="@null"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:textSize="@dimen/driver_type_body"
                android:textColor="@color/textPrimary"
                android:textColorHint="@color/driver_muted"
                app:backgroundTint="@null"
                android:minHeight="48dp"
                android:fontFamily="@font/font_regular" />
            <EditText
                android:id="@+id/originLngInput"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/driver_field"
                android:hint="@string/lng_hint"
                android:inputType="numberDecimal|numberSigned"
                android:padding="12dp"
                android:backgroundTint="@null"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:textSize="@dimen/driver_type_body"
                android:textColor="@color/textPrimary"
                android:textColorHint="@color/driver_muted"
                app:backgroundTint="@null"
                android:minHeight="48dp"
                android:fontFamily="@font/font_regular" />
        </LinearLayout>
        <EditText
            android:id="@+id/destinationLabelInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/driver_field"
            android:hint="@string/destination_label_hint"
            android:padding="12dp"
            android:backgroundTint="@null"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:textSize="@dimen/driver_type_body"
            android:textColor="@color/textPrimary"
            android:textColorHint="@color/driver_muted"
            app:backgroundTint="@null"
            android:minHeight="48dp"
            android:fontFamily="@font/font_regular" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <EditText
                android:id="@+id/destinationLatInput"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginTop="8dp"
                android:background="@drawable/driver_field"
                android:hint="@string/lat_hint"
                android:inputType="numberDecimal|numberSigned"
                android:padding="12dp"
                android:backgroundTint="@null"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:textSize="@dimen/driver_type_body"
                android:textColor="@color/textPrimary"
                android:textColorHint="@color/driver_muted"
                app:backgroundTint="@null"
                android:minHeight="48dp"
                android:fontFamily="@font/font_regular" />
            <EditText
                android:id="@+id/destinationLngInput"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/driver_field"
                android:hint="@string/lng_hint"
                android:inputType="numberDecimal|numberSigned"
                android:padding="12dp"
                android:backgroundTint="@null"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:textSize="@dimen/driver_type_body"
                android:textColor="@color/textPrimary"
                android:textColorHint="@color/driver_muted"
                app:backgroundTint="@null"
                android:minHeight="48dp"
                android:fontFamily="@font/font_regular" />
        </LinearLayout>
        <EditText
            android:id="@+id/departureTimeInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/driver_field"
            android:hint="@string/departure_time_hint"
            android:padding="12dp"
            android:backgroundTint="@null"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:textSize="@dimen/driver_type_body"
            android:textColor="@color/textPrimary"
            android:textColorHint="@color/driver_muted"
            app:backgroundTint="@null"
            android:minHeight="48dp"
            android:fontFamily="@font/font_regular" />
        <EditText
            android:id="@+id/pricePerPassengerInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/driver_field"
            android:hint="@string/price_per_passenger_hint"
            android:inputType="numberDecimal"
            android:padding="12dp"
            android:backgroundTint="@null"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:textSize="@dimen/driver_type_body"
            android:textColor="@color/textPrimary"
            android:textColorHint="@color/driver_muted"
            app:backgroundTint="@null"
            android:minHeight="48dp"
            android:fontFamily="@font/font_regular" />
        <EditText
            android:id="@+id/availableSeatsInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/driver_field"
            android:hint="@string/available_seats_hint"
            android:inputType="number"
            android:padding="12dp"
            android:backgroundTint="@null"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:textSize="@dimen/driver_type_body"
            android:textColor="@color/textPrimary"
            android:textColorHint="@color/driver_muted"
            app:backgroundTint="@null"
            android:minHeight="48dp"
            android:fontFamily="@font/font_regular" />
        <EditText
            android:id="@+id/notificationRadiusInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/driver_field"
            android:hint="@string/notification_radius_hint"
            android:inputType="numberDecimal"
            android:padding="12dp"
            android:backgroundTint="@null"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:textSize="@dimen/driver_type_body"
            android:textColor="@color/textPrimary"
            android:textColorHint="@color/driver_muted"
            app:backgroundTint="@null"
            android:minHeight="48dp"
            android:fontFamily="@font/font_regular" />
        <EditText
            android:id="@+id/broadcastDurationInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/driver_field"
            android:hint="@string/broadcast_duration_hint"
            android:inputType="number"
            android:padding="12dp"
            android:backgroundTint="@null"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:textSize="@dimen/driver_type_body"
            android:textColor="@color/textPrimary"
            android:textColorHint="@color/driver_muted"
            app:backgroundTint="@null"
            android:minHeight="48dp"
            android:fontFamily="@font/font_regular" />
        <Button
            android:id="@+id/createBroadcastButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/create_destination_broadcast"
            android:minHeight="48dp"
            android:textSize="@dimen/driver_type_body"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:fontFamily="@font/font_regular" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/active_destination_broadcasts"
            android:textColor="@color/colorSecondary"
            android:textSize="@dimen/driver_type_heading"
            android:fontFamily="@font/font_regular" />
        <LinearLayout
            android:id="@+id/broadcastsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/destination_join_requests"
            android:textColor="@color/colorSecondary"
            android:textSize="@dimen/driver_type_heading"
            android:fontFamily="@font/font_regular" />
        <LinearLayout
            android:id="@+id/requestsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical" />
    </LinearLayout>
</ScrollView>
