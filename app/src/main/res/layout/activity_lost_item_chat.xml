<?xml version="1.0" encoding="utf-8"?>
<layout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/driver_canvas">
        <com.google.android.material.appbar.AppBarLayout
            android:id="@+id/appBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/white"
            android:theme="@style/ThemeOverlay.AppCompat.Light"
            android:elevation="0dp"
            android:stateListAnimator="@null">
            <androidx.appcompat.widget.Toolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                app:contentInsetLeft="10dp"
                app:contentInsetStart="10dp">
                <include
                    layout="@layout/actionbar_layout" />
            </androidx.appcompat.widget.Toolbar>
            <TextView
                android:id="@+id/title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/font_regular"
                android:paddingLeft="16dp"
                android:paddingRight="15dp"
                android:paddingBottom="6dp"
                android:text="@string/lost_item_follow_up"
                android:textColor="@color/textPrimary"
                android:textSize="@dimen/driver_type_heading" />
            <TextView
                android:id="@+id/subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/font_regular"
                android:paddingLeft="16dp"
                android:paddingRight="15dp"
                android:paddingBottom="15dp"
                android:text="@string/lost_item_follow_up_subtitle"
                android:textColor="@color/textsecondary"
                android:textSize="@dimen/driver_type_body" />
        </com.google.android.material.appbar.AppBarLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            app:layout_behavior="@string/appbar_scrolling_view_behavior">
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerView"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:paddingLeft="14dp"
                android:paddingTop="14dp"
                android:paddingRight="14dp" />
            <TextView
                android:id="@+id/emptyText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:padding="16dp"
                android:text="@string/no_lost_item_messages"
                android:textColor="@color/textsecondary"
                android:visibility="gone"
                android:fontFamily="@font/font_regular"
                android:textSize="@dimen/driver_type_body" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="14dp">
                <EditText
                    android:id="@+id/messageInput"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:background="@drawable/driver_field"
                    android:fontFamily="@font/font_regular"
                    android:hint="@string/type_your_message"
                    android:inputType="textMultiLine"
                    android:paddingLeft="14dp"
                    android:paddingRight="14dp"
                    android:textColor="@color/textPrimary"
                    android:textColorHint="@color/driver_muted"
                    android:backgroundTint="@null"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp"
                    android:textSize="@dimen/driver_type_body"
                    app:backgroundTint="@null"
                    android:minHeight="48dp"
                    android:gravity="top|start" />
                <TextView
                    android:id="@+id/sendMessage"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_marginStart="10dp"
                    android:background="@drawable/primary_bg"
                    android:fontFamily="@font/font_regular"
                    android:gravity="center"
                    android:minWidth="88dp"
                    android:paddingLeft="16dp"
                    android:paddingRight="16dp"
                    android:text="@string/send"
                    android:textColor="@android:color/white"
                    android:textSize="@dimen/driver_type_body"
                    android:minHeight="48dp"
                    android:textStyle="bold"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp" />
            </LinearLayout>
        </LinearLayout>
        <include
            android:id="@+id/progress"
            layout="@layout/progress_lay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center" />
    </androidx.coordinatorlayout.widget.CoordinatorLayout>
</layout>
