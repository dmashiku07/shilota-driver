<?xml version="1.0" encoding="utf-8"?>
<layout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/activity_add_contact.xml">
    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/driver_canvas">
        <com.google.android.material.appbar.AppBarLayout
            android:id="@+id/appBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/white"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:theme="@style/ThemeOverlay.AppCompat.Light"
            android:elevation="0dp"
            android:stateListAnimator="@null">
            <androidx.appcompat.widget.Toolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                app:contentInsetLeft="10dp"
                app:contentInsetStart="10dp"
                app:layout_collapseMode="pin"
                app:popupTheme="@style/ThemeOverlay.AppCompat.Light">
                <include
                    android:id="@+id/custom_toolbar"
                    layout="@layout/actionbar_layout"
                    android:layout_width="48dp"
                    android:layout_height="match_parent" />
                <TextView
                    android:id="@+id/title"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:fontFamily="@font/font_regular"
                    android:paddingBottom="0dp"
                    android:paddingLeft="12dp"
                    android:paddingRight="12dp"
                    android:text="@string/contacts"
                    android:textColor="@color/textPrimary"
                    android:textSize="@dimen/driver_type_heading"
                    android:gravity="center_vertical"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="0dp"
                    android:textStyle="bold"
                    android:maxLines="2"
                    android:ellipsize="end" />
            </androidx.appcompat.widget.Toolbar>
        </com.google.android.material.appbar.AppBarLayout>
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="16dp"
            app:layout_behavior="@string/appbar_scrolling_view_behavior">
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/namelay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:theme="@style/TextInputLayoutDesign"
                app:errorEnabled="true"
                android:layout_marginTop="4dp">
                <EditText
                    android:background="@drawable/driver_field"
                    android:id="@+id/name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/font_regular"
                    android:hint="@string/name"
                    android:textAlignment="viewStart"
                    android:inputType="textPersonName"
                    android:maxLength="30"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp"
                    android:textColor="@color/textPrimary"
                    android:textSize="@dimen/driver_type_body"
                    android:backgroundTint="@null"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:textColorHint="@color/driver_muted"
                    app:backgroundTint="@null"
                    android:minHeight="48dp"
                    android:gravity="start|center_vertical" />
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout
                android:layout_marginTop="4dp"
                android:id="@+id/phoneNumberLay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/namelay"
                android:theme="@style/TextInputLayoutDesign"
                app:errorEnabled="true">
                <EditText
                    android:background="@drawable/driver_field"
                    android:id="@+id/phoneNumber"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:digits="@string/numberfilter"
                    android:textAlignment="viewStart"
                    android:fontFamily="@font/font_regular"
                    android:hint="@string/phonenumber"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp"
                    android:inputType="numberDecimal"
                    android:textColor="@color/textPrimary"
                    android:textSize="@dimen/driver_type_body"
                    android:backgroundTint="@null"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:textColorHint="@color/driver_muted"
                    app:backgroundTint="@null"
                    android:minHeight="48dp"
                    android:gravity="start|center_vertical" />
            </com.google.android.material.textfield.TextInputLayout>
            <LinearLayout
                android:id="@+id/phoneContactlay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/phoneNumberLay"
                android:layout_marginBottom="20dp"
                android:gravity="center">
                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/contact" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/font_regular"
                    android:paddingEnd="15dp"
                    android:paddingStart="15dp"
                    android:text="@string/use_phone_contact"
                    android:textColor="@color/textPrimary"
                    android:textSize="@dimen/driver_type_body" />
            </LinearLayout>
            <RelativeLayout
                android:id="@+id/save"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_below="@+id/phoneContactlay"
                android:layout_marginTop="10dp"
                android:background="@drawable/primary_bg"
                android:gravity="center"
                android:padding="10dp"
                android:minHeight="48dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:fontFamily="@font/font_regular"
                    android:text="@string/save"
                    android:textColor="@color/colorSecondary"
                    android:textSize="@dimen/driver_type_body" />
            </RelativeLayout>
        </RelativeLayout>
    </androidx.coordinatorlayout.widget.CoordinatorLayout>
</layout>
