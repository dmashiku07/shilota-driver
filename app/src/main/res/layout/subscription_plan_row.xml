<?xml version="1.0" encoding="utf-8"?>
<layout
    xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="@drawable/driver_card"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="4dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="4dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/planName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/font_regular"
                android:textColor="@color/textPrimary"
                android:textSize="@dimen/driver_type_heading"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/unlimitedBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/button_style"
                android:paddingLeft="10dp"
                android:paddingTop="10dp"
                android:paddingRight="10dp"
                android:paddingBottom="10dp"
                android:text="@string/unlimited"
                android:textColor="@color/white"
                android:textSize="@dimen/driver_type_body"
                android:visibility="gone"
                android:minHeight="48dp"
                android:gravity="center"
                android:textStyle="bold"
                android:fontFamily="@font/font_regular" />
        </LinearLayout>
        <TextView
            android:id="@+id/planPrice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="@font/font_regular"
            android:textColor="@color/colorPrimary"
            android:textSize="@dimen/driver_type_total"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/planValidity"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="@font/font_regular"
            android:textColor="@color/textPrimary"
            android:textSize="@dimen/driver_type_body" />
        <TextView
            android:id="@+id/planLimit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="@font/font_regular"
            android:textColor="@color/driver_muted"
            android:textSize="@dimen/driver_type_body" />
        <TextView
            android:id="@+id/planDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:fontFamily="@font/font_regular"
            android:textColor="@color/driver_muted"
            android:textSize="@dimen/driver_type_body" />
        <Button
            android:id="@+id/planAction"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/button_style"
            android:fontFamily="@font/font_regular"
            android:minWidth="0dp"
            android:paddingLeft="16dp"
            android:paddingTop="8dp"
            android:paddingRight="16dp"
            android:paddingBottom="8dp"
            android:text="@string/buy_plan"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:minHeight="48dp"
            android:textSize="@dimen/driver_type_body"
            android:paddingStart="16dp"
            android:paddingEnd="16dp" />
    </LinearLayout>
</layout>
