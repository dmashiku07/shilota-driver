<?xml version="1.0" encoding="utf-8"?>
<layout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/usr_contact_layout">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/driver_card"
        android:padding="16dp">
        <TextView
            android:id="@+id/contactLbl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="5dp"
            android:gravity="center"
            android:padding="10dp"
            android:text="@string/contact"
            android:textAllCaps="false"
            android:textColor="@color/colorPrimary"
            android:textSize="@dimen/driver_type_heading"
            android:fontFamily="@font/font_regular" />
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/usrnamelay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/contactLbl"
            android:layout_marginLeft="15dp"
            android:layout_marginRight="15dp"
            android:theme="@style/TextInputLayoutDesign"
            app:errorEnabled="true"
            android:layout_marginTop="4dp">
            <EditText
                android:background="@drawable/driver_field"
                android:id="@+id/usrname"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/name"
                android:inputType="textEmailAddress"
                android:maxLength="30"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:textColor="@color/textPrimary"
                android:textSize="@dimen/driver_type_body"
                android:fontFamily="@font/font_regular"
                android:backgroundTint="@null"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:textColorHint="@color/driver_muted"
                app:backgroundTint="@null"
                android:minHeight="48dp" />
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/emaillay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/usrnamelay"
            android:layout_marginTop="4dp"
            android:layout_marginLeft="15dp"
            android:layout_marginRight="15dp"
            android:theme="@style/TextInputLayoutDesign"
            app:errorEnabled="true">
            <EditText
                android:background="@drawable/driver_field"
                android:id="@+id/email"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/email"
                android:inputType="textEmailAddress"
                android:maxLength="30"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:textColor="@color/textPrimary"
                android:textSize="@dimen/driver_type_body"
                android:fontFamily="@font/font_regular"
                android:backgroundTint="@null"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:textColorHint="@color/driver_muted"
                app:backgroundTint="@null"
                android:minHeight="48dp" />
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/subjectlay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/emaillay"
            android:layout_marginTop="4dp"
            android:layout_marginLeft="15dp"
            android:layout_marginRight="15dp"
            android:theme="@style/TextInputLayoutDesign"
            app:errorEnabled="true">
            <EditText
                android:background="@drawable/driver_field"
                android:id="@+id/subject"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/subject"
                android:inputType="textEmailAddress"
                android:maxLength="30"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:textColor="@color/textPrimary"
                android:textSize="@dimen/driver_type_body"
                android:fontFamily="@font/font_regular"
                android:backgroundTint="@null"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:textColorHint="@color/driver_muted"
                app:backgroundTint="@null"
                android:minHeight="48dp" />
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/messagelay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/subjectlay"
            android:layout_marginTop="4dp"
            android:layout_marginLeft="15dp"
            android:layout_marginRight="15dp"
            android:layout_marginBottom="5dp"
            android:theme="@style/TextInputLayoutDesign"
            app:errorEnabled="true">
            <EditText
                android:background="@drawable/driver_field"
                android:id="@+id/message"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/message"
                android:inputType="textEmailAddress"
                android:maxLength="30"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:textColor="@color/textPrimary"
                android:textSize="@dimen/driver_type_body"
                android:fontFamily="@font/font_regular"
                android:backgroundTint="@null"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:textColorHint="@color/driver_muted"
                app:backgroundTint="@null"
                android:minHeight="48dp" />
        </com.google.android.material.textfield.TextInputLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/messagelay"
            android:layout_margin="5dp"
            android:orientation="horizontal">
            <RelativeLayout
                android:id="@+id/cancelBtn"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_margin="16dp"
                android:layout_weight="1"
                android:background="@drawable/secondary_wo_bg"
                android:gravity="center"
                android:padding="10dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:text="@string/cancel"
                    android:textColor="@color/colorPrimary"
                    android:textSize="@dimen/driver_type_body"
                    android:fontFamily="@font/font_regular" />
            </RelativeLayout>
            <RelativeLayout
                android:id="@+id/sendBtn"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_margin="16dp"
                android:layout_weight="1"
                android:background="@drawable/primary_bg"
                android:gravity="center"
                android:padding="10dp"
                android:minHeight="48dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:text="@string/send"
                    android:textColor="@color/colorSecondary"
                    android:textSize="@dimen/driver_type_body"
                    android:fontFamily="@font/font_regular" />
            </RelativeLayout>
        </LinearLayout>
    </RelativeLayout>
</layout>
