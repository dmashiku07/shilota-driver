<?xml version="1.0" encoding="utf-8"?>
<layout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/activity_add_braintree">
    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/driver_canvas">
        <com.google.android.material.appbar.AppBarLayout
            android:id="@+id/appBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/white"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:theme="@style/ThemeOverlay.AppCompat.Light"
            android:elevation="0dp"
            android:stateListAnimator="@null">
            <androidx.appcompat.widget.Toolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                app:contentInsetLeft="10dp"
                app:contentInsetStart="10dp"
                app:layout_collapseMode="pin"
                app:popupTheme="@style/ThemeOverlay.AppCompat.Light">
                <include
                    layout="@layout/actionbar_layout"
                    android:layout_width="48dp"
                    android:layout_height="match_parent" />
                <TextView
                    android:id="@+id/title"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:fontFamily="@font/font_regular"
                    android:paddingBottom="0dp"
                    android:paddingEnd="12dp"
                    android:paddingStart="12dp"
                    android:text="@string/braintree"
                    android:textColor="@color/textPrimary"
                    android:textSize="@dimen/driver_type_heading"
                    android:gravity="center_vertical"
                    android:paddingLeft="12dp"
                    android:paddingRight="12dp"
                    android:paddingTop="0dp"
                    android:textStyle="bold"
                    android:maxLines="2"
                    android:ellipsize="end" />
            </androidx.appcompat.widget.Toolbar>
        </com.google.android.material.appbar.AppBarLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="15dp"
            android:orientation="vertical"
            app:layout_behavior="@string/appbar_scrolling_view_behavior">
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/routinglay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:visibility="gone"
                android:theme="@style/TextInputLayoutDesign"
                app:errorEnabled="true">
                <EditText
                    android:id="@+id/routingNo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/driver_field"
                    android:fontFamily="@font/font_regular"
                    android:hint="@string/merchantid_hint"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp"
                    android:inputType="textEmailAddress"
                    android:textColor="@color/textPrimary"
                    android:textSize="@dimen/driver_type_body"
                    android:backgroundTint="@null"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:textColorHint="@color/driver_muted"
                    app:backgroundTint="@null"
                    android:minHeight="48dp" />
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/bankAcclay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:theme="@style/TextInputLayoutDesign"
                app:errorEnabled="true">
                <EditText
                    android:id="@+id/bankAcc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAlignment="viewStart"
                    android:background="@drawable/driver_field"
                    android:fontFamily="@font/font_regular"
                    android:hint="@string/publickey_hint"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp"
                    android:inputType="textEmailAddress"
                    android:textColor="@color/textPrimary"
                    android:textSize="@dimen/driver_type_body"
                    android:backgroundTint="@null"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:textColorHint="@color/driver_muted"
                    app:backgroundTint="@null"
                    android:minHeight="48dp"
                    android:gravity="start|center_vertical" />
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/namelay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:theme="@style/TextInputLayoutDesign"
                app:errorEnabled="true">
                <EditText
                    android:id="@+id/name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAlignment="viewStart"
                    android:background="@drawable/driver_field"
                    android:fontFamily="@font/font_regular"
                    android:hint="@string/primaryKey_hint"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp"
                    android:inputType="textEmailAddress"
                    android:textColor="@color/textPrimary"
                    android:textSize="@dimen/driver_type_body"
                    android:backgroundTint="@null"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:textColorHint="@color/driver_muted"
                    app:backgroundTint="@null"
                    android:minHeight="48dp"
                    android:gravity="start|center_vertical" />
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/addresslay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:theme="@style/TextInputLayoutDesign"
                app:errorEnabled="true">
                <EditText
                    android:id="@+id/address"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAlignment="viewStart"
                    android:background="@drawable/driver_field"
                    android:fontFamily="@font/font_regular"
                    android:hint="@string/address"
                    android:inputType="textMultiLine"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp"
                    android:maxLines="4"
                    android:textColor="@color/textPrimary"
                    android:textSize="@dimen/driver_type_body"
                    android:backgroundTint="@null"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:textColorHint="@color/driver_muted"
                    app:backgroundTint="@null"
                    android:minHeight="48dp"
                    android:gravity="top|start" />
            </com.google.android.material.textfield.TextInputLayout>
            <RelativeLayout
                android:id="@+id/saveBtn"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_alignParentBottom="true"
                android:layout_marginBottom="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginStart="16dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/primary_bg"
                android:gravity="center"
                android:padding="10dp"
                android:minHeight="48dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:fontFamily="@font/font_regular"
                    android:text="@string/save"
                    android:textColor="@color/colorSecondary"
                    android:textSize="@dimen/driver_type_body" />
            </RelativeLayout>
        </LinearLayout>
    </androidx.coordinatorlayout.widget.CoordinatorLayout>
</layout>
