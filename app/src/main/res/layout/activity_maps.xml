<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootFrame"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000">
    <LinearLayout
        android:id="@+id/rootll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#fff"
        android:orientation="vertical">
        <fragment
            android:id="@+id/map"
            android:name="com.google.android.gms.maps.SupportMapFragment"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            tools:context="com.hitasoft.driver.hitasoft8.MapsActivity" />
    </LinearLayout>
    <ImageView
        android:id="@+id/backBtn"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="15dp"
        android:layout_marginTop="45dp"
        android:background="@drawable/driver_icon_button"
        android:clickable="true"
        android:padding="10dp"
        android:src="@drawable/back"
        android:visibility="gone"
        android:elevation="3dp" />
    <TextView
        android:id="@+id/sosAlert"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_marginEnd="15dp"
        android:layout_marginTop="40dp"
        android:fontFamily="@font/font_regular"
        android:gravity="center"
        android:text="@string/sos_alert"
        android:textColor="@color/red"
        android:textSize="@dimen/driver_type_body"
        android:visibility="gone"
        android:background="@drawable/driver_card"
        android:minHeight="48dp"
        android:padding="12dp"
        android:elevation="3dp" />
    <TextView
        android:id="@+id/demandHeatmapStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginStart="15dp"
        android:layout_marginTop="78dp"
        android:layout_marginEnd="15dp"
        android:background="@drawable/primary_bg"
        android:fontFamily="@font/font_regular"
        android:paddingStart="12dp"
        android:paddingTop="10dp"
        android:paddingEnd="12dp"
        android:paddingBottom="10dp"
        android:text="@string/demand_heatmap_loading"
        android:textColor="@color/colorWhite"
        android:textSize="@dimen/driver_type_body"
        android:visibility="gone"
        android:minHeight="48dp"
        android:gravity="center"
        android:textStyle="bold" />
    <RelativeLayout
        android:id="@+id/arrivenowLay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/driver_card"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="12dp"
        android:elevation="6dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">
        <TextView
            android:id="@+id/userName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="15dp"
            android:layout_marginTop="18dp"
            android:fontFamily="@font/font_regular"
            android:text=""
            android:textColor="@color/textPrimary"
            android:textSize="@dimen/driver_type_heading"
            android:layout_toStartOf="@id/map_call_2"
            android:textStyle="bold"
            android:minHeight="48dp"
            android:gravity="center_vertical" />
        <TextView
            android:id="@+id/map_call_2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_marginEnd="15dp"
            android:layout_marginTop="18dp"
            android:background="@drawable/driver_soft_card"
            android:fontFamily="@font/font_regular"
            android:paddingBottom="8dp"
            android:paddingEnd="15dp"
            android:paddingStart="15dp"
            android:paddingTop="8dp"
            android:text="@string/call_txt"
            android:textColor="@color/colorPrimary"
            android:textSize="@dimen/driver_type_body"
            android:minHeight="48dp"
            android:gravity="center" />
        <TextView
            android:id="@+id/text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/userName"
            android:layout_marginStart="15dp"
            android:layout_marginEnd="15dp"
            android:layout_marginTop="16dp"
            android:fontFamily="@font/font_regular"
            android:text="@string/pickup"
            android:textAllCaps="true"
            android:textColor="@color/driver_muted"
            android:textSize="@dimen/driver_type_caption" />
        <TextView
            android:id="@+id/address"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/text"
            android:layout_marginStart="15dp"
            android:layout_marginEnd="15dp"
            android:layout_marginTop="6dp"
            android:fontFamily="@font/font_regular"
            android:maxLines="3"
            android:text=""
            android:textColor="@color/textPrimary"
            android:textSize="@dimen/driver_type_body"
            android:minHeight="48dp"
            android:layout_marginBottom="16dp" />
        <LinearLayout
            android:id="@+id/buttonlay"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginBottom="15dp"
            android:orientation="horizontal"
            android:layout_below="@id/address">
            <TextView
                android:id="@+id/arrivingNow"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginEnd="15dp"
                android:layout_marginStart="15dp"
                android:background="@drawable/primary_bg"
                android:fontFamily="@font/font_regular"
                android:gravity="center"
                android:text="@string/arivingnow"
                android:textColor="@color/colorSecondary"
                android:textSize="@dimen/driver_type_body"
                android:textStyle="bold"
                android:minHeight="48dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp" />
        </LinearLayout>
    </RelativeLayout>
    <RelativeLayout
        android:id="@+id/beginrideLay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/driver_card"
        android:visibility="gone"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="12dp"
        android:elevation="6dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/otplay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginEnd="15dp"
            android:layout_marginStart="15dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="15dp"
            android:theme="@style/TextInputLayoutDesign"
            android:layout_below="@id/map_Call">
            <EditText
                android:id="@+id/otp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/driver_field"
                android:fontFamily="@font/font_regular"
                android:hint="@string/otp"
                android:inputType="number"
                android:maxLength="10"
                android:paddingBottom="10dp"
                android:paddingEnd="12dp"
                android:paddingTop="10dp"
                android:textColor="@color/textPrimary"
                android:textSize="@dimen/driver_type_body"
                android:gravity="center"
                android:minHeight="48dp"
                android:paddingStart="12dp"
                android:backgroundTint="@null"
                app:backgroundTint="@null"
                android:textColorHint="@color/driver_muted" />
        </com.google.android.material.textfield.TextInputLayout>
        <TextView
            android:id="@+id/navigate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_marginEnd="15dp"
            android:layout_marginTop="15dp"
            android:background="@drawable/driver_soft_card"
            android:fontFamily="@font/font_regular"
            android:paddingBottom="8dp"
            android:paddingEnd="15dp"
            android:paddingStart="15dp"
            android:paddingTop="8dp"
            android:text="@string/navigate"
            android:textColor="@color/colorPrimary"
            android:textSize="@dimen/driver_type_body"
            android:minHeight="48dp"
            android:gravity="center" />
        <TextView
            android:id="@+id/map_Call"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_marginEnd="15dp"
            android:layout_marginTop="15dp"
            android:background="@drawable/driver_soft_card"
            android:fontFamily="@font/font_regular"
            android:paddingBottom="8dp"
            android:visibility="gone"
            android:paddingEnd="15dp"
            android:layout_below="@id/navigate"
            android:paddingStart="15dp"
            android:paddingTop="8dp"
            android:text="@string/call_txt"
            android:textColor="@color/colorPrimary"
            android:textSize="@dimen/driver_type_body"
            android:minHeight="48dp"
            android:gravity="center" />
        <LinearLayout
            android:id="@+id/bridelay"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginBottom="15dp"
            android:orientation="horizontal"
            android:layout_below="@id/otplay">
            <TextView
                android:id="@+id/beginride"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="15dp"
                android:layout_marginStart="15dp"
                android:layout_weight="3"
                android:background="@drawable/primary_bg"
                android:fontFamily="@font/font_regular"
                android:gravity="center"
                android:text="@string/beginride"
                android:textColor="@color/colorSecondary"
                android:textSize="@dimen/driver_type_body"
                android:textStyle="bold"
                android:minHeight="48dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp" />
        </LinearLayout>
    </RelativeLayout>
    <RelativeLayout
        android:id="@+id/completerideLay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/driver_card"
        android:visibility="gone"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="12dp"
        android:elevation="6dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">
        <TextView
            android:id="@+id/drop"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="15dp"
            android:layout_marginTop="15dp"
            android:fontFamily="@font/font_regular"
            android:text="@string/drop"
            android:textAllCaps="true"
            android:textColor="@color/driver_muted"
            android:textSize="@dimen/driver_type_body"
            android:layout_toStartOf="@id/navigate2"
            android:minHeight="48dp"
            android:gravity="center_vertical" />
        <TextView
            android:id="@+id/dropaddress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/drop"
            android:layout_toLeftOf="@+id/navigate2"
            android:layout_marginStart="15dp"
            android:padding="3dp"
            android:layout_marginEnd="10dp"
            android:fontFamily="@font/font_regular"
            android:maxLines="2"
            android:text=""
            android:textColor="@color/textPrimary"
            android:textSize="@dimen/driver_type_body"
            android:minHeight="48dp"
            android:layout_marginBottom="16dp" />
        <TextView
            android:id="@+id/navigate2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_marginEnd="15dp"
            android:layout_marginTop="15dp"
            android:background="@drawable/driver_soft_card"
            android:fontFamily="@font/font_regular"
            android:paddingBottom="8dp"
            android:paddingEnd="15dp"
            android:paddingStart="15dp"
            android:paddingTop="8dp"
            android:text="@string/navigate"
            android:textColor="@color/colorPrimary"
            android:textSize="@dimen/driver_type_body"
            android:minHeight="48dp"
            android:gravity="center" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginBottom="15dp"
            android:orientation="horizontal"
            android:layout_below="@id/dropaddress">
            <TextView
                android:id="@+id/complete"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="15dp"
                android:layout_marginStart="15dp"
                android:layout_weight="3"
                android:background="@drawable/primary_bg"
                android:fontFamily="@font/font_regular"
                android:gravity="center"
                android:text="@string/completeride"
                android:textColor="@color/colorSecondary"
                android:textSize="@dimen/driver_type_body"
                android:textStyle="bold"
                android:minHeight="48dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp" />
        </LinearLayout>
    </RelativeLayout>
</FrameLayout>
