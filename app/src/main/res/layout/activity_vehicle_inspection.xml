<?xml version="1.0" encoding="utf-8"?>
<layout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/activity_vehicle_inspection">
    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/driver_canvas">
        <com.google.android.material.appbar.AppBarLayout
            android:id="@+id/appBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/white"
            android:theme="@style/ThemeOverlay.AppCompat.Light"
            android:elevation="0dp"
            android:stateListAnimator="@null">
            <androidx.appcompat.widget.Toolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                app:contentInsetLeft="10dp"
                app:contentInsetStart="10dp"
                app:layout_collapseMode="pin"
                app:popupTheme="@style/ThemeOverlay.AppCompat.Light">
                <include
                    android:layout_width="48dp"
                    android:layout_height="match_parent"
                    layout="@layout/actionbar_layout" />
                <TextView
                    android:id="@+id/title1"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:fontFamily="@font/font_regular"
                    android:gravity="center_vertical"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="@string/driver_onboarding"
                    android:textColor="@color/textPrimary"
                    android:textSize="@dimen/driver_type_heading"
                    android:textStyle="bold" />
            </androidx.appcompat.widget.Toolbar>
        </com.google.android.material.appbar.AppBarLayout>
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            app:layout_behavior="@string/appbar_scrolling_view_behavior"
            android:clipToPadding="false">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">
                <TextView
                    android:id="@+id/onboardingMessage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/drawer_soft_card_bg"
                    android:fontFamily="@font/font_regular"
                    android:lineSpacingExtra="2dp"
                    android:padding="16dp"
                    android:text="@string/onboarding_message_pending"
                    android:textColor="@color/textPrimary"
                    android:textSize="@dimen/driver_type_body"
                    android:textStyle="bold" />
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/drawer_soft_card_bg"
                    android:padding="16dp"
                    android:visibility="gone">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:layout_centerVertical="true"
                        android:fontFamily="@font/font_regular"
                        android:text="@string/vehicle_details"
                        android:textColor="@color/textPrimary"
                        android:textSize="@dimen/driver_type_body"
                        android:textStyle="bold" />
                    <TextView
                        android:id="@+id/vehicleDetailsStatusValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:fontFamily="@font/font_regular"
                        android:textColor="@color/driver_muted"
                        android:textSize="@dimen/driver_type_body" />
                </RelativeLayout>
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/drawer_soft_card_bg"
                    android:padding="16dp"
                    android:visibility="gone">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:layout_centerVertical="true"
                        android:fontFamily="@font/font_regular"
                        android:text="@string/payment_details"
                        android:textColor="@color/textPrimary"
                        android:textSize="@dimen/driver_type_body"
                        android:textStyle="bold" />
                    <TextView
                        android:id="@+id/paymentDetailsStatusValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:fontFamily="@font/font_regular"
                        android:textColor="@color/driver_muted"
                        android:textSize="@dimen/driver_type_body" />
                </RelativeLayout>
                <RelativeLayout
                    android:id="@+id/securityDepositStatusRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/drawer_soft_card_bg"
                    android:padding="16dp"
                    android:visibility="gone">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:layout_centerVertical="true"
                        android:fontFamily="@font/font_regular"
                        android:text="@string/security_deposit"
                        android:textColor="@color/textPrimary"
                        android:textSize="@dimen/driver_type_body"
                        android:textStyle="bold" />
                    <TextView
                        android:id="@+id/securityDepositStatusValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:fontFamily="@font/font_regular"
                        android:textColor="@color/driver_muted"
                        android:textSize="@dimen/driver_type_body" />
                </RelativeLayout>
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/drawer_soft_card_bg"
                    android:padding="16dp"
                    android:visibility="gone">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:layout_centerVertical="true"
                        android:fontFamily="@font/font_regular"
                        android:text="@string/vehicle_inspection"
                        android:textColor="@color/textPrimary"
                        android:textSize="@dimen/driver_type_body"
                        android:textStyle="bold" />
                    <TextView
                        android:id="@+id/vehicleInspectionStatusValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:fontFamily="@font/font_regular"
                        android:textColor="@color/driver_muted"
                        android:textSize="@dimen/driver_type_body" />
                </RelativeLayout>
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/drawer_soft_card_bg"
                    android:padding="16dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:layout_centerVertical="true"
                        android:fontFamily="@font/font_regular"
                        android:text="@string/vehicle_approval"
                        android:textColor="@color/textPrimary"
                        android:textSize="@dimen/driver_type_body"
                        android:textStyle="bold" />
                    <TextView
                        android:id="@+id/vehicleApprovalStatusValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:fontFamily="@font/font_regular"
                        android:textColor="@color/driver_muted"
                        android:textSize="@dimen/driver_type_body" />
                </RelativeLayout>
                <TextView
                    android:id="@+id/vehicleDetailsLay"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginBottom="8dp"
                    android:background="@drawable/secondary_bg"
                    android:clickable="true"
                    android:drawablePadding="12dp"
                    android:focusable="true"
                    android:fontFamily="@font/font_regular"
                    android:gravity="center_vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:text="@string/vehicle_details"
                    android:textColor="@color/textPrimary"
                    android:textSize="@dimen/driver_type_body"
                    android:textStyle="bold"
                    app:drawableStartCompat="@drawable/ic_onboarding_edit" />
                <TextView
                    android:id="@+id/paymentDetailsLay"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginBottom="8dp"
                    android:background="@drawable/secondary_bg"
                    android:clickable="true"
                    android:drawablePadding="12dp"
                    android:focusable="true"
                    android:fontFamily="@font/font_regular"
                    android:gravity="center_vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:text="@string/payment_details"
                    android:textColor="@color/textPrimary"
                    android:textSize="@dimen/driver_type_body"
                    android:textStyle="bold"
                    app:drawableStartCompat="@drawable/ic_onboarding_bank" />
                <TextView
                    android:id="@+id/vehicleinspectionLay"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginBottom="8dp"
                    android:background="@drawable/secondary_bg"
                    android:clickable="true"
                    android:drawablePadding="12dp"
                    android:focusable="true"
                    android:fontFamily="@font/font_regular"
                    android:gravity="center_vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:text="@string/vehicle_inspection"
                    android:textColor="@color/textPrimary"
                    android:textSize="@dimen/driver_type_body"
                    android:textStyle="bold"
                    android:visibility="gone"
                    app:drawableStartCompat="@drawable/ic_onboarding_checklist" />
                <TextView
                    android:id="@+id/securityDepositLay"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/secondary_bg"
                    android:clickable="true"
                    android:drawablePadding="12dp"
                    android:focusable="true"
                    android:fontFamily="@font/font_regular"
                    android:gravity="center_vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:text="@string/security_deposit"
                    android:textColor="@color/textPrimary"
                    android:textSize="@dimen/driver_type_body"
                    android:textStyle="bold"
                    android:visibility="gone"
                    app:drawableStartCompat="@drawable/ic_onboarding_shield" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <TextView
                        android:id="@+id/licenseUploadLay"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_marginEnd="5dp"
                        android:layout_weight="1"
                        android:background="@drawable/secondary_bg"
                        android:clickable="true"
                        android:drawablePadding="8dp"
                        android:focusable="true"
                        android:fontFamily="@font/font_regular"
                        android:gravity="center"
                        android:text="@string/license_short"
                        android:textColor="@color/textPrimary"
                        android:textSize="@dimen/driver_type_body"
                        android:textStyle="bold"
                        app:drawableStartCompat="@drawable/ic_onboarding_badge" />
                    <TextView
                        android:id="@+id/insuranceUploadLay"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_marginStart="5dp"
                        android:layout_marginEnd="5dp"
                        android:layout_weight="1"
                        android:background="@drawable/secondary_bg"
                        android:clickable="true"
                        android:drawablePadding="8dp"
                        android:focusable="true"
                        android:fontFamily="@font/font_regular"
                        android:gravity="center"
                        android:text="@string/insurance_short"
                        android:textColor="@color/textPrimary"
                        android:textSize="@dimen/driver_type_body"
                        android:textStyle="bold"
                        app:drawableStartCompat="@drawable/ic_onboarding_shield" />
                    <TextView
                        android:id="@+id/bookUploadLay"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_marginStart="5dp"
                        android:layout_weight="1"
                        android:background="@drawable/secondary_bg"
                        android:clickable="true"
                        android:drawablePadding="8dp"
                        android:focusable="true"
                        android:fontFamily="@font/font_regular"
                        android:gravity="center"
                        android:text="@string/rc_book_short"
                        android:textColor="@color/textPrimary"
                        android:textSize="@dimen/driver_type_body"
                        android:textStyle="bold"
                        app:drawableStartCompat="@drawable/ic_onboarding_doc" />
                </LinearLayout>
                <TextView
                    android:id="@+id/logoutLay"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/secondary_bg"
                    android:clickable="true"
                    android:drawablePadding="12dp"
                    android:focusable="true"
                    android:fontFamily="@font/font_regular"
                    android:gravity="center_vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:text="@string/logout"
                    android:textColor="@color/textPrimary"
                    android:textSize="@dimen/driver_type_body"
                    android:textStyle="bold"
                    app:drawableStartCompat="@drawable/ic_onboarding_logout" />
            </LinearLayout>
        </ScrollView>
    </androidx.coordinatorlayout.widget.CoordinatorLayout>
</layout>
