<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorSecondary"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    android:theme="@style/ThemeOverlay.AppCompat.Dark">
    <RelativeLayout
        android:id="@+id/userLay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="@dimen/activity_vertical_margin"
        android:background="@drawable/driver_soft_card"
        android:padding="16dp"
        android:layout_marginBottom="16dp">
        <LinearLayout
            android:id="@+id/usrLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:layout_centerVertical="true"
            android:orientation="vertical"
            android:paddingStart="0dp"
            android:layout_toStartOf="@id/userImage">
            <TextView
                android:id="@+id/userName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingTop="4dp"
                android:text="User name"
                android:textColor="@color/textPrimary"
                android:textSize="@dimen/driver_type_heading"
                android:fontFamily="@font/font_regular"
                android:textStyle="bold" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="@string/view_edit_profile"
                android:textColor="@color/textsecondary"
                android:textSize="@dimen/driver_type_body"
                android:fontFamily="@font/font_regular" />
        </LinearLayout>
        <com.makeramen.roundedimageview.RoundedImageView
            android:id="@+id/userImage"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:scaleType="centerCrop"
            android:src="@drawable/temp"
            app:riv_corner_radius="30dp"
            app:riv_mutate_background="true" />
    </RelativeLayout>
    <ListView
        android:id="@+id/nav_menu_listview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/colorSecondary" />
    <View
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:background="@color/divider" />
</LinearLayout>
