<?xml version="1.0" encoding="utf-8"?>
<layout
    xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout
        android:id="@+id/activity_welcome"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/colorSecondary"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="24dp"
        android:paddingEnd="16dp"
        android:paddingBottom="24dp">
        <TextureView
            android:id="@+id/textureView"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />
        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <ImageView
                android:layout_width="48dp"
                android:layout_height="58dp"
                android:contentDescription="@string/app_name"
                android:scaleType="fitCenter"
                android:src="@drawable/app_logo" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:fontFamily="@font/font_regular"
                android:text="@string/app_name"
                android:textColor="@color/textPrimary"
                android:textSize="@dimen/driver_type_heading" />
        </LinearLayout>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="@font/font_regular"
            android:lineSpacingExtra="2dp"
            android:text="@string/welcome_driver_heading"
            android:textColor="@color/textPrimary"
            android:textSize="@dimen/driver_type_total" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="@font/font_regular"
            android:lineSpacingExtra="4dp"
            android:text="@string/welcome_driver_subtitle"
            android:textColor="@color/driver_muted"
            android:textSize="@dimen/driver_type_body" />
        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />
        <TextView
            android:id="@+id/login"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:background="@drawable/primary_bg"
            android:fontFamily="@font/font_regular"
            android:gravity="center"
            android:text="@string/sign_in"
            android:textColor="@color/colorSecondary"
            android:textSize="@dimen/driver_type_body"
            android:minHeight="48dp"
            android:textStyle="bold"
            android:paddingTop="10dp"
            android:paddingBottom="10dp" />
        <TextView
            android:id="@+id/signup"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/welcome_outline_primary"
            android:fontFamily="@font/font_regular"
            android:gravity="center"
            android:text="@string/create_driver_account"
            android:textColor="@color/colorPrimary"
            android:textSize="@dimen/driver_type_body" />
    </LinearLayout>
</layout>
