<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/top"
    android:layout_width="match_parent"
    android:layout_height="?attr/actionBarSize"
    android:background="@color/colorSecondary"
    android:minHeight="?attr/actionBarSize">
    <ImageView
        android:id="@+id/navBtn"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_centerVertical="true"
        android:layout_gravity="center_vertical"
        android:background="@drawable/driver_icon_button"
        android:clickable="true"
        android:padding="14dp"
        android:src="@drawable/nav"
        android:visibility="invisible" />
    <ImageView
        android:id="@+id/backBtn"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_centerVertical="true"
        android:layout_gravity="center_vertical"
        android:background="@drawable/driver_icon_button"
        android:clickable="true"
        android:padding="14dp"
        android:src="@drawable/back"
        android:visibility="invisible" />
    <TextView
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_toEndOf="@+id/backBtn"
        android:fontFamily="@font/font_regular"
        android:paddingEnd="3dp"
        android:paddingStart="3dp"
        android:text=""
        android:textColor="@color/textPrimary"
        android:textSize="@dimen/driver_type_heading"
        android:textStyle="bold" />
    <ImageView
        android:id="@+id/appName"
        android:layout_width="wrap_content"
        android:layout_height="50dp"
        android:layout_centerHorizontal="true"
        android:layout_centerVertical="true"
        android:src="@drawable/app_logo"
        android:visibility="invisible" />
    <ImageView
        android:id="@+id/notifyBtn"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_alignParentEnd="true"
        android:layout_centerVertical="true"
        android:layout_gravity="center_vertical"
        android:layout_marginEnd="15dp"
        android:background="@drawable/driver_icon_button"
        android:clickable="true"
        android:padding="14dp"
        android:src="@drawable/notification"
        android:visibility="invisible" />
    <RelativeLayout
        android:id="@+id/notiBadgeLay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignEnd="@+id/notifyBtn"
        android:layout_marginEnd="3dp"
        android:layout_marginTop="15dp"
        android:orientation="vertical"
        android:visibility="invisible">
        <ImageView
            android:id="@+id/notibadgeBg"
            android:layout_width="15dp"
            android:layout_height="15dp"
            android:layout_centerInParent="true"
            android:src="@drawable/filled_blue_circle"
            android:visibility="visible"
            app:tint="@color/colorSecondary" />
        <TextView
            android:id="@+id/notiBadgeCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:fontFamily="@font/font_regular"
            android:text="0"
            android:textColor="@color/colorPrimary"
            android:textSize="@dimen/driver_type_badge" />
    </RelativeLayout>
</RelativeLayout>
