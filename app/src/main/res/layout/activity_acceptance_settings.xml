<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/driver_canvas">
    <include
        android:id="@+id/actionBar"
        layout="@layout/actionbar_layout" />
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/actionBar"
        android:padding="16dp"
        android:clipToPadding="false">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/acceptance_settings"
                android:textColor="@color/textPrimary"
                android:textSize="@dimen/driver_type_heading"
                android:textStyle="bold"
                android:fontFamily="@font/font_regular" />
            <CheckBox
                android:id="@+id/autoAccept"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/acceptance_auto_accept"
                android:minHeight="48dp"
                android:textSize="@dimen/driver_type_body"
                android:fontFamily="@font/font_regular" />
            <EditText
                android:id="@+id/maxPickupDistance"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/driver_field"
                android:hint="@string/acceptance_max_pickup"
                android:inputType="numberDecimal"
                android:padding="14dp"
                android:backgroundTint="@null"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:textSize="@dimen/driver_type_body"
                android:textColor="@color/textPrimary"
                android:textColorHint="@color/driver_muted"
                app:backgroundTint="@null"
                android:minHeight="48dp"
                android:fontFamily="@font/font_regular" />
            <EditText
                android:id="@+id/minFare"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/driver_field"
                android:hint="@string/acceptance_min_fare"
                android:inputType="numberDecimal"
                android:padding="14dp"
                android:backgroundTint="@null"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:textSize="@dimen/driver_type_body"
                android:textColor="@color/textPrimary"
                android:textColorHint="@color/driver_muted"
                app:backgroundTint="@null"
                android:minHeight="48dp"
                android:fontFamily="@font/font_regular" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="@string/acceptance_ride_types"
                android:textStyle="bold"
                android:fontFamily="@font/font_regular"
                android:textSize="@dimen/driver_type_body" />
            <CheckBox
                android:id="@+id/rideTypeRide"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/service_ride"
                android:minHeight="48dp"
                android:textSize="@dimen/driver_type_body"
                android:fontFamily="@font/font_regular" />
            <CheckBox
                android:id="@+id/rideTypeDelivery"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/service_delivery"
                android:minHeight="48dp"
                android:textSize="@dimen/driver_type_body"
                android:fontFamily="@font/font_regular" />
            <CheckBox
                android:id="@+id/rideTypePool"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/acceptance_pool"
                android:minHeight="48dp"
                android:textSize="@dimen/driver_type_body"
                android:fontFamily="@font/font_regular" />
            <Button
                android:id="@+id/saveButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/button_style"
                android:text="@string/save"
                android:textColor="@android:color/white"
                android:minHeight="48dp"
                android:textSize="@dimen/driver_type_body"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:fontFamily="@font/font_regular" />
        </LinearLayout>
    </ScrollView>
</RelativeLayout>
