<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootFrame"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/driver_canvas"
    android:keepScreenOn="true">
    <androidx.drawerlayout.widget.DrawerLayout
        android:id="@+id/drawer_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fitsSystemWindows="true"
        tools:openDrawer="start">
        <androidx.coordinatorlayout.widget.CoordinatorLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/driver_canvas"
            android:fitsSystemWindows="true"
            tools:context="com.example.customnavigationdrawer.MainActivity">
            <com.google.android.material.appbar.AppBarLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:theme="@style/AppTheme.AppBarOverlay"
                android:elevation="0dp"
                android:stateListAnimator="@null"
                android:background="@color/white">
                <androidx.appcompat.widget.Toolbar
                    android:id="@+id/toolbar"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:background="@color/colorSecondary"
                    app:popupTheme="@style/AppTheme.PopupOverlay">
                    <include
                        layout="@layout/actionbar_layout" />
                </androidx.appcompat.widget.Toolbar>
            </com.google.android.material.appbar.AppBarLayout>
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                app:layout_behavior="@string/appbar_scrolling_view_behavior">
                <ScrollView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scrollbars="none"
                    android:paddingBottom="68dp"
                    android:clipToPadding="false">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:paddingBottom="24dp">
                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="0dp"
                            android:layout_marginTop="16dp"
                            android:padding="12dp"
                            android:background="@drawable/driver_card">
                            <com.makeramen.roundedimageview.RoundedImageView
                                android:id="@+id/dashuserImage"
                                android:layout_width="48dp"
                                android:layout_height="48dp"
                                android:layout_alignParentStart="true"
                                android:layout_gravity="center"
                                android:adjustViewBounds="true"
                                android:scaleType="centerCrop"
                                android:src="@drawable/temp"
                                app:riv_corner_radius="100dip"
                                app:riv_mutate_background="true" />
                            <RelativeLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_alignParentTop="true"
                                android:layout_centerVertical="true"
                                android:layout_marginStart="12dp"
                                android:layout_toEndOf="@+id/dashuserImage"
                                android:orientation="vertical">
                                <TextView
                                    android:id="@+id/driverName"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textAlignment="viewStart"
                                    android:layout_marginStart="0dp"
                                    android:fontFamily="@font/font_regular"
                                    android:textColor="@color/textPrimary"
                                    android:textSize="@dimen/driver_type_body"
                                    android:textStyle="bold" />
                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_alignParentStart="true"
                                    android:layout_below="@+id/driverName"
                                    android:gravity="center_vertical"
                                    android:orientation="horizontal">
                                    <ImageView
                                        android:id="@+id/ratingStar"
                                        android:layout_width="30dp"
                                        android:layout_height="30dp"
                                        android:padding="5dp"
                                        android:src="@drawable/ic_star_24dp" />
                                    <TextView
                                        android:id="@+id/rating"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_gravity="center_vertical"
                                        android:layout_marginEnd="5dp"
                                        android:fontFamily="@font/font_regular"
                                        android:text="3.2"
                                        android:textColor="@color/textPrimary"
                                        android:textSize="@dimen/driver_type_body" />
                                </LinearLayout>
                            </RelativeLayout>
                        </RelativeLayout>
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:id="@+id/online_lay"
                            android:orientation="horizontal"
                            android:padding="12dp"
                            android:layout_marginTop="8dp"
                            android:layout_marginBottom="8dp"
                            android:background="@drawable/driver_soft_card"
                            android:paddingTop="8dp"
                            android:paddingBottom="8dp"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp">
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:layout_weight="1">
                                <TextView
                                    android:id="@+id/online_text"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="@font/font_regular"
                                    android:gravity="start"
                                    android:maxLines="2"
                                    android:text="@string/online"
                                    android:textColor="@color/colorPrimary"
                                    android:textSize="@dimen/driver_type_body"
                                    android:textStyle="bold" />
                                <TextView
                                    android:id="@+id/subscriptionUsageSummary"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp"
                                    android:fontFamily="@font/font_regular"
                                    android:gravity="start"
                                    android:maxLines="3"
                                    android:textColor="@color/driver_muted"
                                    android:textSize="@dimen/driver_type_badge" />
                            </LinearLayout>
                            <androidx.appcompat.widget.SwitchCompat
                                android:id="@+id/onlineSwitch"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                app:theme="@style/Color1SwitchStyle"
                                android:minHeight="48dp"
                                android:textSize="@dimen/driver_type_body"
                                android:fontFamily="@font/font_regular" />
                        </LinearLayout>
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_marginStart="0dp"
                            android:layout_marginEnd="0dp"
                            android:layout_marginTop="12dp"
                            android:layout_marginBottom="8dp">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/font_regular"
                                android:text="@string/rides"
                                android:textColor="@color/textsecondary"
                                android:textSize="@dimen/driver_type_body" />
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="10dp"
                                android:background="@drawable/secondary_dashbard_whole_bg"
                                android:orientation="horizontal"
                                android:weightSum="2">
                                <RelativeLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:orientation="vertical"
                                    android:padding="10dp">
                                    <TextView
                                        android:id="@+id/rideactive"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_centerHorizontal="true"
                                        android:fontFamily="@font/font_regular"
                                        android:paddingStart="10dp"
                                        android:paddingEnd="10dp"
                                        android:text="@string/today"
                                        android:textAllCaps="false"
                                        android:textColor="@color/textsecondary"
                                        android:textSize="@dimen/driver_type_body" />
                                    <TextView
                                        android:id="@+id/activecount"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_below="@+id/rideactive"
                                        android:layout_centerHorizontal="true"
                                        android:layout_marginTop="4dp"
                                        android:fontFamily="@font/font_regular"
                                        android:text="6"
                                        android:textColor="@color/textPrimary"
                                        android:textSize="@dimen/driver_type_heading"
                                        android:textStyle="bold" />
                                </RelativeLayout>
                                <View
                                    android:layout_width="1dp"
                                    android:layout_height="match_parent"
                                    android:background="@color/divider" />
                                <RelativeLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:orientation="vertical"
                                    android:padding="10dp">
                                    <TextView
                                        android:id="@+id/ride_completed"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_centerHorizontal="true"
                                        android:fontFamily="@font/font_regular"
                                        android:paddingStart="10dp"
                                        android:paddingEnd="10dp"
                                        android:text="@string/thismonth"
                                        android:textAllCaps="false"
                                        android:textColor="@color/textsecondary"
                                        android:textSize="@dimen/driver_type_body" />
                                    <TextView
                                        android:id="@+id/completedcount"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_below="@+id/ride_completed"
                                        android:layout_centerHorizontal="true"
                                        android:layout_marginTop="4dp"
                                        android:fontFamily="@font/font_regular"
                                        android:text="12"
                                        android:textColor="@color/textPrimary"
                                        android:textSize="@dimen/driver_type_heading"
                                        android:textStyle="bold" />
                                </RelativeLayout>
                            </LinearLayout>
                        </LinearLayout>
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="0dp"
                            android:layout_marginEnd="0dp"
                            android:orientation="vertical"
                            android:visibility="gone">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/font_regular"
                                android:text="@string/advertisements"
                                android:textAllCaps="false"
                                android:textColor="@color/textsecondary"
                                android:textSize="@dimen/driver_type_body" />
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="10dp"
                                android:background="@drawable/secondary_dashbard_whole_bg"
                                android:orientation="horizontal"
                                android:weightSum="2">
                                <RelativeLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:orientation="vertical"
                                    android:padding="10dp">
                                    <TextView
                                        android:id="@+id/total_km"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_centerHorizontal="true"
                                        android:fontFamily="@font/font_regular"
                                        android:paddingStart="10dp"
                                        android:paddingEnd="10dp"
                                        android:text="@string/total_km"
                                        android:textAllCaps="false"
                                        android:textColor="@color/textsecondary"
                                        android:textSize="@dimen/driver_type_body" />
                                    <TextView
                                        android:id="@+id/totalkm"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_below="@+id/total_km"
                                        android:layout_centerHorizontal="true"
                                        android:layout_marginTop="4dp"
                                        android:fontFamily="@font/font_regular"
                                        android:text="458"
                                        android:textColor="@color/textsecondary"
                                        android:textSize="@dimen/driver_type_body" />
                                </RelativeLayout>
                                <View
                                    android:layout_width="1dp"
                                    android:layout_height="match_parent"
                                    android:background="@color/divider" />
                                <RelativeLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:orientation="vertical"
                                    android:padding="10dp">
                                    <TextView
                                        android:id="@+id/earned"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_centerHorizontal="true"
                                        android:fontFamily="@font/font_regular"
                                        android:paddingStart="10dp"
                                        android:paddingEnd="10dp"
                                        android:text="@string/earned"
                                        android:textAllCaps="false"
                                        android:textColor="@color/textsecondary"
                                        android:textSize="@dimen/driver_type_body" />
                                    <TextView
                                        android:id="@+id/earnedamount"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_below="@+id/earned"
                                        android:layout_centerHorizontal="true"
                                        android:layout_marginTop="4dp"
                                        android:fontFamily="@font/font_regular"
                                        android:text="@string/driver_zero_amount"
                                        android:textColor="@color/textsecondary"
                                        android:textSize="@dimen/driver_type_body" />
                                </RelativeLayout>
                            </LinearLayout>
                        </LinearLayout>
                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:padding="16dp"
                            android:layout_marginStart="0dp"
                            android:layout_marginEnd="0dp"
                            android:background="@drawable/driver_dark_card"
                            android:layout_marginBottom="8dp">
                            <TextView
                                android:id="@+id/total_earnings"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/font_regular"
                                android:paddingStart="0dp"
                                android:paddingEnd="0dp"
                                android:text="@string/total_earnings"
                                android:textAllCaps="false"
                                android:textColor="@color/white"
                                android:textSize="@dimen/driver_type_caption"
                                android:layout_alignParentStart="true" />
                            <TextView
                                android:id="@+id/earning"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_below="@id/total_earnings"
                                android:layout_marginTop="8dp"
                                android:fontFamily="@font/font_regular"
                                android:text="@string/driver_zero_amount"
                                android:textColor="@color/white"
                                android:textSize="@dimen/driver_type_total"
                                android:textStyle="bold"
                                android:layout_alignParentStart="true"
                                android:paddingStart="0dp"
                                android:paddingEnd="0dp" />
                        </RelativeLayout>
                        <com.jjoe64.graphview.GraphView
                            android:id="@+id/graph"
                            android:layout_width="match_parent"
                            android:layout_height="180dp"
                            android:layout_marginStart="0dp"
                            android:layout_marginEnd="0dp"
                            android:layout_marginBottom="16dp"
                            android:paddingStart="5dp"
                            android:paddingEnd="5dp"
                            android:background="@drawable/driver_card"
                            android:padding="12dp" />
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="0dp"
                            android:layout_marginTop="15dp"
                            android:layout_marginEnd="0dp"
                            android:layout_marginBottom="16dp"
                            android:orientation="vertical"
                            android:background="@drawable/driver_card"
                            android:padding="16dp">
                            <RelativeLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="10dp"
                                android:orientation="vertical">
                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_alignParentStart="true"
                                    android:layout_centerHorizontal="true"
                                    android:fontFamily="@font/font_regular"
                                    android:text="@string/bookings"
                                    android:textAllCaps="false"
                                    android:textColor="@color/textsecondary"
                                    android:textSize="@dimen/driver_type_body"
                                    android:layout_toStartOf="@id/bookings"
                                    android:layout_marginEnd="12dp" />
                                <TextView
                                    android:id="@+id/bookings"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_alignParentEnd="true"
                                    android:fontFamily="@font/font_regular"
                                    android:text="225"
                                    android:textColor="@color/textPrimary"
                                    android:textSize="@dimen/driver_type_body"
                                    android:textStyle="bold" />
                            </RelativeLayout>
                            <RelativeLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="10dp"
                                android:orientation="vertical">
                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_alignParentStart="true"
                                    android:layout_centerHorizontal="true"
                                    android:fontFamily="@font/font_regular"
                                    android:text="@string/total_earnings"
                                    android:textColor="@color/textsecondary"
                                    android:textSize="@dimen/driver_type_body"
                                    android:layout_toStartOf="@id/totalearning"
                                    android:layout_marginEnd="12dp" />
                                <TextView
                                    android:id="@+id/totalearning"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_alignParentEnd="true"
                                    android:fontFamily="@font/font_regular"
                                    android:text="@string/driver_zero_amount"
                                    android:textColor="@color/textPrimary"
                                    android:textSize="@dimen/driver_type_body"
                                    android:textStyle="bold" />
                            </RelativeLayout>
                            <RelativeLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="10dp"
                                android:orientation="vertical">
                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_alignParentStart="true"
                                    android:layout_centerHorizontal="true"
                                    android:fontFamily="@font/font_regular"
                                    android:text="@string/cash_collected"
                                    android:textAllCaps="false"
                                    android:textColor="@color/textsecondary"
                                    android:textSize="@dimen/driver_type_body"
                                    android:layout_toStartOf="@id/cashcollected"
                                    android:layout_marginEnd="12dp" />
                                <TextView
                                    android:id="@+id/cashcollected"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_alignParentEnd="true"
                                    android:fontFamily="@font/font_regular"
                                    android:text="@string/driver_zero_amount"
                                    android:textColor="@color/textPrimary"
                                    android:textSize="@dimen/driver_type_body"
                                    android:textStyle="bold" />
                            </RelativeLayout>
                            <RelativeLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="20dp"
                                android:orientation="vertical">
                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_alignParentStart="true"
                                    android:layout_centerHorizontal="true"
                                    android:fontFamily="@font/font_regular"
                                    android:text="@string/available_amount"
                                    android:textColor="@color/textsecondary"
                                    android:textSize="@dimen/driver_type_body"
                                    android:layout_toStartOf="@id/availableamount"
                                    android:layout_marginEnd="12dp" />
                                <TextView
                                    android:id="@+id/availableamount"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_alignParentEnd="true"
                                    android:fontFamily="@font/font_regular"
                                    android:text="225"
                                    android:textColor="@color/textPrimary"
                                    android:textSize="@dimen/driver_type_body"
                                    android:textStyle="bold" />
                            </RelativeLayout>
                        </LinearLayout>
                    </LinearLayout>
                </ScrollView>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_alignParentBottom="true"
                    android:background="@color/colorSecondary"
                    android:elevation="15dp"
                    android:orientation="vertical">
                    <RelativeLayout
                        android:id="@+id/onlinelay"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_marginEnd="16dp"
                        android:background="@drawable/driver_soft_card"
                        android:layout_marginBottom="8dp"
                        android:layout_marginTop="8dp"
                        android:minHeight="48dp">
                        <ImageView
                            android:id="@+id/onlineIndicator"
                            android:layout_width="30dp"
                            android:layout_height="30dp"
                            android:layout_alignParentStart="true"
                            android:layout_centerVertical="true"
                            android:layout_gravity="center_vertical"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:clickable="true"
                            android:padding="10dp"
                            android:src="@drawable/online" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentStart="true"
                            android:layout_centerHorizontal="true"
                            android:layout_centerVertical="true"
                            android:layout_toEndOf="@+id/onlineIndicator"
                            android:fontFamily="@font/font_regular"
                            android:paddingStart="25dp"
                            android:text="@string/online_mode_msg"
                            android:textAllCaps="false"
                            android:textColor="@color/textsecondary"
                            android:textSize="@dimen/driver_type_body" />
                        <ImageView
                            android:id="@+id/nextBtn"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:layout_gravity="center_vertical"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:clickable="true"
                            android:padding="10dp"
                            android:src="@drawable/arrow_right"
                            android:visibility="invisible" />
                    </RelativeLayout>
                </LinearLayout>
            </RelativeLayout>
        </androidx.coordinatorlayout.widget.CoordinatorLayout>
        <com.google.android.material.navigation.NavigationView
            android:id="@+id/nav_view"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_gravity="start"
            android:background="@color/colorSecondary"
            android:fitsSystemWindows="true"
            android:paddingStart="@dimen/activity_horizontal_margin"
            android:paddingEnd="@dimen/activity_horizontal_margin"
            app:headerLayout="@layout/nav_header_fragment_main"
            app:itemIconTint="@color/textPrimary"
            app:itemVerticalPadding="6dp"
            app:itemTextAppearance="@style/NavigationDrawerTextStyle"
            app:itemTextColor="@color/textPrimary"
            app:menu="@menu/activity_fragment_main_drawer" />
    </androidx.drawerlayout.widget.DrawerLayout>
</FrameLayout>
