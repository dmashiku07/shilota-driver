<?xml version="1.0" encoding="utf-8"?>
<layout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/name_dialog">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/driver_card"
        android:orientation="vertical"
        android:padding="16dp">
        <TextView
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="5dp"
            android:fontFamily="@font/font_regular"
            android:gravity="center"
            android:padding="10dp"
            android:text="@string/change_name"
            android:textAllCaps="false"
            android:textColor="@color/colorPrimary"
            android:textSize="@dimen/driver_type_heading" />
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/nameLay"
            android:layout_below="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:theme="@style/TextInputLayoutDesign"
            app:errorEnabled="true">
            <EditText
                android:id="@+id/edtName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/driver_field"
                android:fontFamily="@font/font_regular"
                android:hint="@string/name"
                android:imeOptions="actionDone"
                android:inputType="text"
                android:textColor="@color/textPrimary"
                android:textSize="@dimen/driver_type_body"
                android:backgroundTint="@null"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:textColorHint="@color/driver_muted"
                app:backgroundTint="@null"
                android:minHeight="48dp" />
        </com.google.android.material.textfield.TextInputLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/nameLay"
            android:layout_margin="5dp"
            android:orientation="horizontal">
            <RelativeLayout
                android:id="@+id/cancelBtn"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_margin="16dp"
                android:layout_weight="1"
                android:background="@drawable/secondary_wo_bg"
                android:gravity="center"
                android:padding="10dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:fontFamily="@font/font_regular"
                    android:text="@string/cancel"
                    android:textColor="@color/colorPrimary"
                    android:textSize="@dimen/driver_type_body" />
            </RelativeLayout>
            <RelativeLayout
                android:id="@+id/saveBtn"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_margin="16dp"
                android:layout_weight="1"
                android:background="@drawable/primary_bg"
                android:gravity="center"
                android:padding="10dp"
                android:minHeight="48dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:fontFamily="@font/font_regular"
                    android:text="@string/save"
                    android:textColor="@color/colorSecondary"
                    android:textSize="@dimen/driver_type_body" />
            </RelativeLayout>
        </LinearLayout>
    </RelativeLayout>
</layout>
