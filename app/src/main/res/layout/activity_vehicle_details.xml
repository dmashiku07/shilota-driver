<?xml version="1.0" encoding="utf-8"?>
<layout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/activity_vehicle_details">
    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/driver_canvas">
        <com.google.android.material.appbar.AppBarLayout
            android:id="@+id/appBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/white"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:theme="@style/ThemeOverlay.AppCompat.Light"
            android:elevation="0dp"
            android:stateListAnimator="@null">
            <androidx.appcompat.widget.Toolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                app:contentInsetLeft="10dp"
                app:contentInsetStart="10dp"
                app:layout_collapseMode="pin"
                app:popupTheme="@style/ThemeOverlay.AppCompat.Light">
                <include
                    layout="@layout/actionbar_layout"
                    android:layout_width="48dp"
                    android:layout_height="match_parent" />
                <TextView
                    android:id="@+id/title"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:fontFamily="@font/font_regular"
                    android:paddingBottom="0dp"
                    android:paddingLeft="12dp"
                    android:paddingRight="12dp"
                    android:text="@string/vehicle_details"
                    android:textColor="@color/textPrimary"
                    android:textSize="@dimen/driver_type_heading"
                    android:gravity="center_vertical"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="0dp"
                    android:textStyle="bold"
                    android:maxLines="2"
                    android:ellipsize="end" />
            </androidx.appcompat.widget.Toolbar>
        </com.google.android.material.appbar.AppBarLayout>
        <ScrollView
            android:id="@+id/vehicleDetailsScroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scrollbars="none"
            app:layout_behavior="@string/appbar_scrolling_view_behavior"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:descendantFocusability="afterDescendants">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="96dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="15dp"
                    android:orientation="vertical">
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/vehicleNamelay"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:theme="@style/TextInputLayoutDesign">
                        <EditText
                            android:id="@+id/vehicleName"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textAlignment="viewStart"
                            android:background="@drawable/driver_field"
                            android:fontFamily="@font/font_regular"
                            android:hint="@string/vehicle_name"
                            android:inputType="textEmailAddress"
                            android:maxLength="30"
                            android:paddingBottom="10dp"
                            android:paddingEnd="12dp"
                            android:paddingTop="10dp"
                            android:textColor="@color/textPrimary"
                            android:textSize="@dimen/driver_type_body"
                            android:backgroundTint="@null"
                            android:paddingStart="12dp"
                            android:textColorHint="@color/driver_muted"
                            app:backgroundTint="@null"
                            android:minHeight="48dp"
                            android:gravity="start|center_vertical" />
                    </com.google.android.material.textfield.TextInputLayout>
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/noOfSeatslay"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:theme="@style/TextInputLayoutDesign">
                        <EditText
                            android:id="@+id/noOfSeats"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textAlignment="viewStart"
                            android:background="@drawable/driver_field"
                            android:fontFamily="@font/font_regular"
                            android:hint="@string/no_of_seats"
                            android:inputType="number"
                            android:maxLength="2"
                            android:paddingBottom="10dp"
                            android:paddingEnd="12dp"
                            android:paddingTop="10dp"
                            android:textColor="@color/textPrimary"
                            android:textSize="@dimen/driver_type_body"
                            android:backgroundTint="@null"
                            android:paddingStart="12dp"
                            android:textColorHint="@color/driver_muted"
                            app:backgroundTint="@null"
                            android:minHeight="48dp"
                            android:gravity="start|center_vertical" />
                    </com.google.android.material.textfield.TextInputLayout>
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp">
                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/bodyTypeLay"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_alignParentStart="true"
                            android:layout_marginTop="4dp"
                            android:theme="@style/TextInputLayoutDesign">
                            <EditText
                                android:id="@+id/bodyType"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textAlignment="viewStart"
                                android:layout_marginTop="10dp"
                                android:background="@drawable/driver_field"
                                android:clickable="true"
                                android:focusable="false"
                                android:focusableInTouchMode="false"
                                android:fontFamily="@font/font_regular"
                                android:hint="@string/body_type"
                                android:inputType="textEmailAddress"
                                android:maxLength="30"
                                android:paddingBottom="10dp"
                                android:paddingEnd="12dp"
                                android:paddingTop="10dp"
                                android:textColor="@color/textPrimary"
                                android:textSize="@dimen/driver_type_body"
                                android:backgroundTint="@null"
                                android:paddingStart="12dp"
                                android:textColorHint="@color/driver_muted"
                                app:backgroundTint="@null"
                                android:minHeight="48dp"
                                android:gravity="start|center_vertical" />
                        </com.google.android.material.textfield.TextInputLayout>
                        <ImageView
                            android:id="@+id/icon"
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:layout_marginStart="10dp"
                            android:clickable="true"
                            android:rotation="270"
                            android:src="@drawable/down_arrow"
                            android:visibility="visible" />
                    </RelativeLayout>
                    <LinearLayout
                        android:id="@+id/serviceCapabilityLay"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_edit_text"
                        android:orientation="vertical"
                        android:paddingBottom="10dp"
                        android:paddingEnd="10dp"
                        android:paddingStart="10dp"
                        android:paddingTop="10dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/font_regular"
                            android:text="@string/service_capability"
                            android:textColor="@color/textPrimary"
                            android:textSize="@dimen/driver_type_body" />
                        <CheckBox
                            android:id="@+id/serviceRide"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="true"
                            android:fontFamily="@font/font_regular"
                            android:text="@string/service_ride"
                            android:textColor="@color/textPrimary"
                            android:textSize="@dimen/driver_type_body"
                            android:minHeight="48dp" />
                        <CheckBox
                            android:id="@+id/serviceDelivery"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/font_regular"
                            android:text="@string/service_delivery"
                            android:textColor="@color/textPrimary"
                            android:textSize="@dimen/driver_type_body"
                            android:minHeight="48dp" />
                    </LinearLayout>
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp">
                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/amenitiesLay"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_alignParentStart="true"
                            android:layout_marginTop="4dp"
                            android:theme="@style/TextInputLayoutDesign">
                            <EditText
                                android:id="@+id/amenities"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textAlignment="viewStart"
                                android:background="@drawable/driver_field"
                                android:clickable="true"
                                android:focusable="false"
                                android:focusableInTouchMode="false"
                                android:fontFamily="@font/font_regular"
                                android:hint="@string/amenities"
                                android:inputType="textEmailAddress"
                                android:maxLength="30"
                                android:paddingBottom="10dp"
                                android:paddingEnd="12dp"
                                android:paddingTop="10dp"
                                android:textColor="@color/textPrimary"
                                android:textSize="@dimen/driver_type_body"
                                android:backgroundTint="@null"
                                android:paddingStart="12dp"
                                android:textColorHint="@color/driver_muted"
                                app:backgroundTint="@null"
                                android:minHeight="48dp"
                                android:gravity="start|center_vertical" />
                        </com.google.android.material.textfield.TextInputLayout>
                        <ImageView
                            android:id="@+id/amenitiesIcon"
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:layout_marginStart="10dp"
                            android:clickable="true"
                            android:rotation="270"
                            android:src="@drawable/down_arrow"
                            android:visibility="visible" />
                    </RelativeLayout>
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/vehicleNumberlay"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:theme="@style/TextInputLayoutDesign">
                        <EditText
                            android:id="@+id/vehicleNumber"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textAlignment="viewStart"
                            android:background="@drawable/driver_field"
                            android:fontFamily="@font/font_regular"
                            android:hint="@string/vehicle_number"
                            android:inputType="textEmailAddress"
                            android:maxLength="30"
                            android:paddingBottom="10dp"
                            android:paddingEnd="12dp"
                            android:paddingTop="10dp"
                            android:textColor="@color/textPrimary"
                            android:textSize="@dimen/driver_type_body"
                            android:backgroundTint="@null"
                            android:paddingStart="12dp"
                            android:textColorHint="@color/driver_muted"
                            app:backgroundTint="@null"
                            android:minHeight="48dp"
                            android:gravity="start|center_vertical" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
                <View
                    android:layout_width="match_parent"
                    android:layout_height="0.5dp"
                    android:layout_marginBottom="10dp"
                    android:layout_marginTop="15dp"
                    android:background="@color/transparent" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="15dp"
                    android:orientation="vertical">
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/licenceNumberlay"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:theme="@style/TextInputLayoutDesign">
                        <EditText
                            android:id="@+id/licenceNumber"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textAlignment="viewStart"
                            android:background="@drawable/driver_field"
                            android:fontFamily="@font/font_regular"
                            android:hint="@string/licence_number"
                            android:inputType="textEmailAddress"
                            android:maxLength="30"
                            android:paddingBottom="10dp"
                            android:paddingEnd="12dp"
                            android:paddingTop="10dp"
                            android:textColor="@color/textPrimary"
                            android:textSize="@dimen/driver_type_body"
                            android:backgroundTint="@null"
                            android:paddingStart="12dp"
                            android:textColorHint="@color/driver_muted"
                            app:backgroundTint="@null"
                            android:minHeight="48dp"
                            android:gravity="start|center_vertical" />
                    </com.google.android.material.textfield.TextInputLayout>
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/licenceDoclay"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:theme="@style/TextInputLayoutDesign">
                        <EditText
                            android:id="@+id/licenceDoc"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textAlignment="viewStart"
                            android:background="@drawable/driver_field"
                            android:focusable="false"
                            android:focusableInTouchMode="false"
                            android:fontFamily="@font/font_regular"
                            android:hint="@string/licence_document"
                            android:maxLength="30"
                            android:paddingBottom="10dp"
                            android:paddingEnd="12dp"
                            android:paddingTop="10dp"
                            android:textColor="@color/textPrimary"
                            android:textSize="@dimen/driver_type_body"
                            android:backgroundTint="@null"
                            android:paddingStart="12dp"
                            android:textColorHint="@color/driver_muted"
                            app:backgroundTint="@null"
                            android:minHeight="48dp"
                            android:gravity="start|center_vertical" />
                    </com.google.android.material.textfield.TextInputLayout>
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/licenceExpiryDatelay"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:theme="@style/TextInputLayoutDesign">
                        <EditText
                            android:id="@+id/licenceExpiryDate"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textAlignment="viewStart"
                            android:background="@drawable/driver_field"
                            android:focusableInTouchMode="false"
                            android:fontFamily="@font/font_regular"
                            android:hint="@string/licence_expiry_date"
                            android:inputType="textEmailAddress"
                            android:maxLength="30"
                            android:paddingBottom="10dp"
                            android:paddingEnd="12dp"
                            android:paddingTop="10dp"
                            android:textColor="@color/textPrimary"
                            android:textSize="@dimen/driver_type_body"
                            android:backgroundTint="@null"
                            android:paddingStart="12dp"
                            android:textColorHint="@color/driver_muted"
                            app:backgroundTint="@null"
                            android:minHeight="48dp"
                            android:gravity="start|center_vertical" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
                <View
                    android:layout_width="match_parent"
                    android:layout_height="0.5dp"
                    android:layout_marginBottom="10dp"
                    android:layout_marginTop="15dp"
                    android:background="@color/transparent" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="15dp"
                    android:orientation="vertical">
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/insuranceNumberlay"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:theme="@style/TextInputLayoutDesign">
                        <EditText
                            android:id="@+id/insuranceNumber"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textAlignment="viewStart"
                            android:background="@drawable/driver_field"
                            android:fontFamily="@font/font_regular"
                            android:hint="@string/insurance_number"
                            android:inputType="textEmailAddress"
                            android:maxLength="30"
                            android:paddingBottom="10dp"
                            android:paddingEnd="12dp"
                            android:paddingTop="10dp"
                            android:textColor="@color/textPrimary"
                            android:textSize="@dimen/driver_type_body"
                            android:backgroundTint="@null"
                            android:paddingStart="12dp"
                            android:textColorHint="@color/driver_muted"
                            app:backgroundTint="@null"
                            android:minHeight="48dp"
                            android:gravity="start|center_vertical" />
                    </com.google.android.material.textfield.TextInputLayout>
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/insuranceDoclay"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:theme="@style/TextInputLayoutDesign">
                        <EditText
                            android:id="@+id/insuranceDoc"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textAlignment="viewStart"
                            android:background="@drawable/driver_field"
                            android:focusable="false"
                            android:focusableInTouchMode="false"
                            android:fontFamily="@font/font_regular"
                            android:hint="@string/insurance_document"
                            android:inputType="textEmailAddress"
                            android:maxLength="30"
                            android:paddingBottom="10dp"
                            android:paddingEnd="12dp"
                            android:paddingTop="10dp"
                            android:textColor="@color/textPrimary"
                            android:textSize="@dimen/driver_type_body"
                            android:backgroundTint="@null"
                            android:paddingStart="12dp"
                            android:textColorHint="@color/driver_muted"
                            app:backgroundTint="@null"
                            android:minHeight="48dp"
                            android:gravity="start|center_vertical" />
                    </com.google.android.material.textfield.TextInputLayout>
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/insuranceExpiryDatelay"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:theme="@style/TextInputLayoutDesign">
                        <EditText
                            android:id="@+id/insuranceExpiryDate"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textAlignment="viewStart"
                            android:background="@drawable/driver_field"
                            android:focusableInTouchMode="false"
                            android:fontFamily="@font/font_regular"
                            android:hint="@string/insurance_expiry_date"
                            android:inputType="textEmailAddress"
                            android:maxLength="30"
                            android:paddingBottom="10dp"
                            android:paddingEnd="12dp"
                            android:paddingTop="10dp"
                            android:textColor="@color/textPrimary"
                            android:textSize="@dimen/driver_type_body"
                            android:backgroundTint="@null"
                            android:paddingStart="12dp"
                            android:textColorHint="@color/driver_muted"
                            app:backgroundTint="@null"
                            android:minHeight="48dp"
                            android:gravity="start|center_vertical" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="15dp"
                    android:orientation="vertical"
                    android:visibility="gone">
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/rcBookNumberlay"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:theme="@style/TextInputLayoutDesign">
                        <EditText
                            android:id="@+id/rcBookNumber"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textAlignment="viewStart"
                            android:background="@drawable/driver_field"
                            android:fontFamily="@font/font_regular"
                            android:hint="@string/rc_book_number"
                            android:inputType="textEmailAddress"
                            android:maxLength="30"
                            android:paddingBottom="10dp"
                            android:paddingEnd="12dp"
                            android:paddingTop="10dp"
                            android:textColor="@color/textPrimary"
                            android:textSize="@dimen/driver_type_body"
                            android:backgroundTint="@null"
                            android:paddingStart="12dp"
                            android:textColorHint="@color/driver_muted"
                            app:backgroundTint="@null"
                            android:minHeight="48dp"
                            android:gravity="start|center_vertical" />
                    </com.google.android.material.textfield.TextInputLayout>
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/rcBookDoclay"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:theme="@style/TextInputLayoutDesign">
                        <EditText
                            android:id="@+id/rcBookDoc"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textAlignment="viewStart"
                            android:background="@drawable/driver_field"
                            android:focusable="false"
                            android:focusableInTouchMode="false"
                            android:fontFamily="@font/font_regular"
                            android:hint="@string/rc_book_document"
                            android:inputType="textEmailAddress"
                            android:maxLength="30"
                            android:paddingBottom="10dp"
                            android:paddingEnd="12dp"
                            android:paddingTop="10dp"
                            android:textColor="@color/textPrimary"
                            android:textSize="@dimen/driver_type_body"
                            android:backgroundTint="@null"
                            android:paddingStart="12dp"
                            android:textColorHint="@color/driver_muted"
                            app:backgroundTint="@null"
                            android:minHeight="48dp"
                            android:gravity="start|center_vertical" />
                    </com.google.android.material.textfield.TextInputLayout>
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/rcBookExpiryDatelay"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:theme="@style/TextInputLayoutDesign">
                        <EditText
                            android:id="@+id/rcBookExpiryDate"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textAlignment="viewStart"
                            android:background="@drawable/driver_field"
                            android:focusableInTouchMode="false"
                            android:fontFamily="@font/font_regular"
                            android:hint="@string/rc_book_expiry_date"
                            android:inputType="textEmailAddress"
                            android:maxLength="30"
                            android:paddingBottom="10dp"
                            android:paddingEnd="12dp"
                            android:paddingTop="10dp"
                            android:textColor="@color/textPrimary"
                            android:textSize="@dimen/driver_type_body"
                            android:backgroundTint="@null"
                            android:paddingStart="12dp"
                            android:textColorHint="@color/driver_muted"
                            app:backgroundTint="@null"
                            android:minHeight="48dp"
                            android:gravity="start|center_vertical" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
                <TextView
                    android:id="@+id/nextBtn"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginBottom="16dp"
                    android:layout_marginEnd="15dp"
                    android:layout_marginStart="15dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/primary_bg"
                    android:fontFamily="@font/font_regular"
                    android:gravity="center"
                    android:padding="10dp"
                    android:text="@string/next"
                    android:textColor="@color/colorSecondary"
                    android:textSize="@dimen/driver_type_body"
                    android:minHeight="48dp"
                    android:textStyle="bold"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp" />
            </LinearLayout>
        </ScrollView>
    </androidx.coordinatorlayout.widget.CoordinatorLayout>
</layout>
