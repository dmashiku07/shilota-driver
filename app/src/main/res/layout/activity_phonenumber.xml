<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/driver_canvas">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_margin="15dp"
        android:id="@+id/layout_one"
        android:visibility="visible">
        <androidx.appcompat.widget.AppCompatTextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/PrimaryTextBold1"
            android:layout_gravity="center"
            android:gravity="center"
            android:textAlignment="center"
            android:text="@string/txt_otp_verification"
            android:fontFamily="@font/font_regular"
            android:textSize="@dimen/driver_type_body" />
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:src="@drawable/img_new_enterpin"
            android:layout_margin="10dp" />
        <androidx.appcompat.widget.AppCompatTextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/PrimaryTextBold2"
            android:layout_gravity="center"
            android:gravity="center"
            android:textAlignment="center"
            android:layout_margin="10dp"
            android:text="@string/txt_enter_your_mobile_number"
            android:fontFamily="@font/font_regular"
            android:textSize="@dimen/driver_type_body" />
        <androidx.appcompat.widget.AppCompatTextView
            android:layout_margin="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/GrayTextNormal"
            android:layout_gravity="center"
            android:gravity="center"
            android:textAlignment="center"
            android:text="@string/txt_otpdesc"
            android:fontFamily="@font/font_regular"
            android:textSize="@dimen/driver_type_body" />
        <LinearLayout
            android:id="@+id/phonenumberlayout"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:orientation="horizontal"
            android:layout_margin="10dp"
            android:layoutDirection="locale"
            android:background="@drawable/bg_otp_gray">
            <ImageView
                android:id="@+id/ccp"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginStart="15dp"
                android:layout_marginEnd="15dp"
                android:layout_gravity="center" />
            <View
                android:layout_width="0.5dp"
                android:layout_height="match_parent"
                android:background="@color/texttertiary"
                android:layout_marginRight="10dp" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="50dp"
                android:textSize="@dimen/driver_type_body"
                android:text="+255"
                android:layout_marginRight="10dp"
                android:textColor="@color/colorBlack"
                android:id="@+id/tvCC"
                android:fontFamily="@font/font_regular" />
            <EditText
                android:textDirection="locale"
                android:layout_weight="1"
                android:id="@+id/phonenumber"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:background="@drawable/driver_field"
                android:hint="@string/txt_enter_your_mobile_number"
                android:singleLine="true"
                android:textAlignment="viewStart"
                android:cursorVisible="true"
                android:textCursorDrawable="@null"
                android:imeOptions="actionNext"
                android:inputType="number"
                android:textColorHint="@color/driver_muted"
                android:textSize="@dimen/driver_type_body"
                android:textColor="@color/textPrimary"
                android:backgroundTint="@null"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                app:backgroundTint="@null"
                android:minHeight="48dp"
                android:gravity="start|center_vertical"
                android:fontFamily="@font/font_regular" />
        </LinearLayout>
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btngetotp"
            android:layout_width="match_parent"
            android:layout_height="45dp"
            android:fontFamily="@font/font_regular"
            android:background="@drawable/bg_otp"
            android:text="@string/txt_getotp"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:textSize="@dimen/driver_type_body"
            android:layout_margin="10dp"
            android:minHeight="48dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_margin="15dp"
        android:id="@+id/layout_two"
        android:visibility="gone">
        <androidx.appcompat.widget.AppCompatTextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/PrimaryTextBold1"
            android:layout_gravity="center"
            android:gravity="center"
            android:textAlignment="center"
            android:text="@string/txt_enter_verification_code"
            android:fontFamily="@font/font_regular"
            android:textSize="@dimen/driver_type_body" />
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:src="@drawable/img_new_enterotp"
            android:layout_margin="10dp" />
        <androidx.appcompat.widget.AppCompatTextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/PrimaryTextBold2"
            android:layout_gravity="center"
            android:gravity="center"
            android:textAlignment="center"
            android:layout_margin="10dp"
            android:text="@string/txt_enterotp"
            android:fontFamily="@font/font_regular"
            android:textSize="@dimen/driver_type_body" />
        <androidx.appcompat.widget.AppCompatTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/yourOTP"
            android:gravity="center"
            style="@style/PrimaryTextBold2"
            android:layout_margin="10dp"
            android:textAlignment="center"
            android:fontFamily="@font/font_regular"
            android:textSize="@dimen/driver_type_body" />
        <androidx.appcompat.widget.AppCompatTextView
            android:layout_margin="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/GrayTextNormal"
            android:layout_gravity="center"
            android:gravity="center"
            android:textAlignment="center"
            android:id="@+id/txt_phonenumber_entered"
            android:text="@string/txt_entercode"
            android:fontFamily="@font/font_regular"
            android:textSize="@dimen/driver_type_body" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_margin="15dp"
            android:gravity="center"
            android:orientation="horizontal">
            <RelativeLayout
                android:layout_width="45dp"
                android:layout_height="50dp"
                android:layout_gravity="center"
                android:gravity="center">
                <EditText
                    android:id="@+id/text1"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_gravity="center"
                    android:background="@drawable/driver_field"
                    android:fontFamily="@font/font_regular"
                    android:gravity="center"
                    android:imeOptions="actionDone"
                    android:inputType="number"
                    android:text=""
                    android:maxLength="1"
                    android:textAlignment="center"
                    android:textColor="@color/textPrimary"
                    android:textSize="@dimen/driver_type_body"
                    android:backgroundTint="@null"
                    android:paddingStart="2dp"
                    android:paddingEnd="2dp"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp"
                    android:textColorHint="@color/driver_muted"
                    app:backgroundTint="@null" />
            </RelativeLayout>
            <View
                android:layout_width="7dp"
                android:layout_height="match_parent" />
            <RelativeLayout
                android:layout_width="45dp"
                android:layout_height="50dp">
                <EditText
                    android:id="@+id/text2"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_gravity="center"
                    android:background="@drawable/driver_field"
                    android:fontFamily="@font/font_regular"
                    android:gravity="center"
                    android:imeOptions="actionDone"
                    android:inputType="number"
                    android:maxLength="1"
                    android:text=""
                    android:textAlignment="center"
                    android:textColor="@color/textPrimary"
                    android:textSize="@dimen/driver_type_body"
                    android:backgroundTint="@null"
                    android:paddingStart="2dp"
                    android:paddingEnd="2dp"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp"
                    android:textColorHint="@color/driver_muted"
                    app:backgroundTint="@null" />
            </RelativeLayout>
            <View
                android:layout_width="7dp"
                android:layout_height="match_parent" />
            <RelativeLayout
                android:layout_width="45dp"
                android:layout_height="50dp">
                <EditText
                    android:id="@+id/text3"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_gravity="center"
                    android:background="@drawable/driver_field"
                    android:fontFamily="@font/font_regular"
                    android:gravity="center"
                    android:imeOptions="actionDone"
                    android:inputType="number"
                    android:maxLength="1"
                    android:text=""
                    android:textAlignment="center"
                    android:textColor="@color/textPrimary"
                    android:textSize="@dimen/driver_type_body"
                    android:backgroundTint="@null"
                    android:paddingStart="2dp"
                    android:paddingEnd="2dp"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp"
                    android:textColorHint="@color/driver_muted"
                    app:backgroundTint="@null" />
            </RelativeLayout>
            <View
                android:layout_width="7dp"
                android:layout_height="match_parent" />
            <RelativeLayout
                android:layout_width="45dp"
                android:layout_height="50dp">
                <EditText
                    android:id="@+id/text4"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_gravity="center"
                    android:background="@drawable/driver_field"
                    android:fontFamily="@font/font_regular"
                    android:gravity="center"
                    android:imeOptions="actionDone"
                    android:inputType="number"
                    android:maxLength="1"
                    android:text=""
                    android:textAlignment="center"
                    android:textColor="@color/textPrimary"
                    android:textSize="@dimen/driver_type_body"
                    android:backgroundTint="@null"
                    android:paddingStart="2dp"
                    android:paddingEnd="2dp"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp"
                    android:textColorHint="@color/driver_muted"
                    app:backgroundTint="@null" />
            </RelativeLayout>
            <View
                android:layout_width="7dp"
                android:layout_height="match_parent" />
            <RelativeLayout
                android:layout_width="45dp"
                android:layout_height="50dp"
                android:layout_gravity="center"
                android:gravity="center">
                <EditText
                    android:id="@+id/text5"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_gravity="center"
                    android:background="@drawable/driver_field"
                    android:fontFamily="@font/font_regular"
                    android:gravity="center"
                    android:imeOptions="actionDone"
                    android:inputType="number"
                    android:text=""
                    android:maxLength="1"
                    android:textAlignment="center"
                    android:textColor="@color/textPrimary"
                    android:textSize="@dimen/driver_type_body"
                    android:backgroundTint="@null"
                    android:paddingStart="2dp"
                    android:paddingEnd="2dp"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp"
                    android:textColorHint="@color/driver_muted"
                    app:backgroundTint="@null" />
            </RelativeLayout>
            <View
                android:layout_width="7dp"
                android:layout_height="match_parent" />
            <RelativeLayout
                android:layout_width="45dp"
                android:layout_height="50dp"
                android:layout_gravity="center"
                android:gravity="center">
                <EditText
                    android:id="@+id/text6"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_gravity="center"
                    android:background="@drawable/driver_field"
                    android:fontFamily="@font/font_regular"
                    android:gravity="center"
                    android:imeOptions="actionDone"
                    android:inputType="number"
                    android:text=""
                    android:maxLength="1"
                    android:textAlignment="center"
                    android:textColor="@color/textPrimary"
                    android:textSize="@dimen/driver_type_body"
                    android:backgroundTint="@null"
                    android:paddingStart="2dp"
                    android:paddingEnd="2dp"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp"
                    android:textColorHint="@color/driver_muted"
                    app:backgroundTint="@null" />
            </RelativeLayout>
        </LinearLayout>
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/verify"
            android:layout_width="match_parent"
            android:layout_height="45dp"
            android:fontFamily="@font/font_regular"
            android:background="@drawable/bg_otp"
            android:text="@string/txt_verify"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:textSize="@dimen/driver_type_body"
            android:layout_margin="10dp"
            android:minHeight="48dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp" />
        <androidx.appcompat.widget.AppCompatTextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/red"
            android:fontFamily="@font/font_regular"
            android:layout_gravity="center"
            android:gravity="center"
            android:textAlignment="center"
            android:layout_margin="10dp"
            android:id="@+id/txt_resend_otp"
            android:text="@string/otp_resend"
            android:textSize="@dimen/driver_type_body" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
